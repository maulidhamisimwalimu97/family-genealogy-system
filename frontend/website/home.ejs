<script>
const headerText = "Discover Your Family Roots";
const subText = "Trace your ancestry, build your family tree, and connect with your heritage today.";

function typeText(elementId, text, delay = 100) {
    const el = document.getElementById(elementId);
    el.textContent = "";
    let i = 0;
    const interval = setInterval(() => {
        if (i < text.length) {
            el.textContent += text.charAt(i);
            i++;
        } else {
            clearInterval(interval);
        }
    }, delay);
}

// On page load
window.addEventListener('DOMContentLoaded', () => {
    typeText("typing-header", headerText, 100);
    setTimeout(() => {
        typeText("typing-subheader", subText, 30);
    }, headerText.length * 100 + 500); // delay subtext after header finishes
});
</script>
