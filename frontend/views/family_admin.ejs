<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">

  <title>Dashboard - Family Admin Panel</title>
  <meta content="Family Admin Panel for managing family genealogy records" name="description">
  <meta content="family, genealogy, admin, lineage" name="keywords">

  <!-- Favicons -->


  <!-- Google Fonts -->
  <link href="https://fonts.gstatic.com" rel="preconnect">
  <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,300i,400,400i,600,600i,700,700i|Nunito:300,300i,400,400i,600,600i,700,700i|Poppins:300,300i,400,400i,500,500i,600,600i,700,700i" rel="stylesheet">

  <!-- Vendor CSS Files -->
  <link href="/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
  <link href="/assets/vendor/boxicons/css/boxicons.min.css" rel="stylesheet">
  <link href="/assets/vendor/quill/quill.snow.css" rel="stylesheet">
  <link href="/assets/vendor/quill/quill.bubble.css" rel="stylesheet">
  <link href="/assets/vendor/remixicon/remixicon.css" rel="stylesheet">
  <link href="/assets/vendor/simple-datatables/style.css" rel="stylesheet">

  <!-- Main CSS File -->
  <link href="assets/css/style.css" rel="stylesheet">
  <link href="/assets/css/dark.css" rel="stylesheet">
</head>

<body>

  <!-- ======= Header ======= -->
<%- include('partials/title') %>
  
<%- include('partials/header') %>

<!-- the main content start -->
<main id="main" class="main">

  <div class="pagetitle">
    <h1>Admin Dashboard</h1>
    <nav>
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/admin">Home</a></li>
        <li class="breadcrumb-item active">Dashboard</li>
      </ol>
    </nav>
  </div>

  <section class="section dashboard">
    <div class="row">

      <!-- Left side columns -->
      <div class="col-lg-8">
        <div class="row">
            <!-- Members Card as Link -->
            <div class="col-xxl-4 col-md-6">
            <a href="/family_lists" class="text-decoration-none">
                <div class="card info-card members-card">
                <div class="card-body">
                    <h5 class="card-title">Members</h5>
                    <div class="d-flex align-items-center">
                    <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                        <i class="bi bi-people"></i>
                    </div>
                    <div class="ps-3">
                    <h6><%= totalMembers %></h6>
                        <span class="text-muted small">Members</span>
                    </div>
                    </div>
                </div>
                </div>
            </a>
            </div>

            <!-- Billing Overview -->
            <div class="col-xxl-4 col-md-6">
              <a href="/package" class="text-decoration-none">
                <div class="card info-card billing-card">
                  <div class="card-body">
                    <h5 class="card-title">Billing Overview</h5>
                    <div class="d-flex align-items-center">
                      <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                        <i class="bi bi-credit-card text-warning fs-4"></i>
                      </div>
                      <div class="ps-3">
                        <h6><%= totalAdults %> Adults</h6>
                      </div>
                    </div>
                  </div>
                </div>
              </a>
            </div>
            <!-- Upcoming Meetings Card as Link -->
            <div class="col-xxl-4 col-md-6">
            <a href="/meeting_list" class="text-decoration-none">
                <div class="card info-card meetings-card">
                <div class="card-body">
                    <h5 class="card-title">Upcoming Meetings</h5>
                    <div class="d-flex align-items-center">
                    <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                        <i class="bi bi-calendar-event"></i>
                    </div>
                    <div class="ps-3">
                        <h6><%= totalMeetings %></h6>
                        <span class="text-success small fw-bold">Reminders set</span>
                    </div>
                    </div>
                </div>
                </div>
            </a>
            </div>

            <!-- Family Tree -->
            <div class="col-xxl-4 col-md-6">
            <a href="/family_tree" class="text-decoration-none">
                <div class="card info-card family-tree-card">
                <div class="card-body">
                    <h5 class="card-title">Family Tree</h5>
                    <div class="d-flex align-items-center">
                    <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                        <i class="bi bi-diagram-3 text-primary fs-4"></i>
                    </div>
                    <div class="ps-3">
                        <span class="text-black small">See your family lineage</span>
                    </div>
                    </div>
                </div>
                </div>
            </a>
            </div>

            <!-- Reports -->
            <div class="col-12">
              <div class="card">
                <div class="card-body">
                  <h5 class="card-title">Family Age Distribution</h5>

                  <%
                    // Calculate total members for age chart
                    const totalAge =
                      (age_0_10 || 0) +
                      (age_11_20 || 0) +
                      (age_21_40 || 0) +
                      (age_41_60 || 0) +
                      (age_60_plus || 0);
                  %>

                  <% if (totalAge === 0) { %>
                    <!-- 🔴 No Data Message inside the card -->
                    <div class="alert alert-danger text-center my-3">
                      <i class="bi bi-exclamation-triangle"></i>
                      No family member data available to display age distribution.
                    </div>
                  <% } else { %>
                    <!-- 📊 Chart Canvas -->
                    <canvas id="ageChart" style="max-height: 400px;"></canvas>

                    <!-- Hidden Inputs to safely pass data to JS -->
                    <input type="hidden" id="age_0_10" value="<%= age_0_10 || 0 %>">
                    <input type="hidden" id="age_11_20" value="<%= age_11_20 || 0 %>">
                    <input type="hidden" id="age_21_40" value="<%= age_21_40 || 0 %>">
                    <input type="hidden" id="age_41_60" value="<%= age_41_60 || 0 %>">
                    <input type="hidden" id="age_60_plus" value="<%= age_60_plus || 0 %>">

                    <!-- Chart.js -->
                    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
                    <script>
                      const ctx = document.getElementById('ageChart');

                      const ageData = [
                        Number(document.getElementById('age_0_10').value),
                        Number(document.getElementById('age_11_20').value),
                        Number(document.getElementById('age_21_40').value),
                        Number(document.getElementById('age_41_60').value),
                        Number(document.getElementById('age_60_plus').value)
                      ];

                      new Chart(ctx, {
                        type: 'pie',
                        data: {
                          labels: ['0-10 yrs', '11-20 yrs', '21-40 yrs', '41-60 yrs', '60+ yrs'],
                          datasets: [{
                            data: ageData,
                            backgroundColor: [
                              'rgba(75, 192, 192, 0.7)',
                              'rgba(54, 162, 235, 0.7)',
                              'rgba(255, 206, 86, 0.7)',
                              'rgba(255, 99, 132, 0.7)',
                              'rgba(153, 102, 255, 0.7)'
                            ]
                          }]
                        },
                        options: {
                          responsive: true,
                          plugins: {
                            legend: {
                              position: 'bottom'
                            }
                          }
                        }
                      });
                    </script>
                  <% } %>
                </div>
              </div>
            </div>
            <!-- Recent Family Members -->
            <div class="col-12">
              <div class="card recent-sales overflow-auto">
                <div class="card-body">
                  <h5 class="card-title">Family Members & Roles</h5>

                  <% if (!familyMembers || familyMembers.length === 0) { %>
                    <!-- 🔴 No Members -->
                    <div class="alert alert-danger text-center my-3">
                      <i class="bi bi-exclamation-triangle"></i>
                      No family members found.
                    </div>
                  <% } else { %>
                    <table class="table table-borderless">
                      <thead>
                        <tr>
                          <th>#</th>
                          <th>Member Name</th>
                          <th>Role</th>
                          <th>Status</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% familyMembers.forEach((member, index) => { %>
                          <tr>
                            <th><%= index + 1 %></th>
                            <td><%= member.first_name %> <%= member.last_name %></td>
                            <td><%= member.role === 'family_admin' ? 'Admin' : 'Member' %></td>
                            <td>
                              <% if(member.role === 'family_admin') { %>
                                <span class="badge bg-info">Active</span>
                              <% } else { %>
                                <% if(member.is_future_head) { %>
                                  <span class="badge bg-warning">Pending</span>
                                <% } else { %>
                                  <span class="badge bg-secondary">Inactive</span>
                                <% } %>
                              <% } %>
                            </td>
                          </tr>
                        <% }) %>
                      </tbody>
                    </table>
                  <% } %>

                </div>
              </div>
            </div>
          </div>
        </div>
      <!-- Right side columns -->
      <div class="col-lg-4">

       <!-- Recent Activities -->
<div class="card">
  <div class="card-body">
    <h5 class="card-title">Recent Activities</h5>

    <% if (!recentActivities || recentActivities.length === 0) { %>
      <div class="alert alert-danger text-center my-3">
        <i class="bi bi-exclamation-triangle"></i>
        No recent activities available.
      </div>
    <% } else { %>
      <div class="activity">
        <% recentActivities.forEach(activity => { %>
          <div class="activity-item d-flex">
            <div class="activite-label">
              <%= new Date(activity.activity_time).toLocaleString('en-US', { 
                    month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' 
                  }) %>
            </div>
            <i class="bi bi-circle-fill activity-badge <%= activity.type === 'member' ? 'text-primary' : 'text-warning' %>"></i>
            <div class="activity-content">
              <% if(activity.type === 'member') { %>
                New Member <strong><%= activity.name %></strong> registered
              <% } else if(activity.type === 'meeting') { %>
                Reminder: <strong><%= activity.name %></strong> meeting scheduled
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>

  </div>
</div>
        <!-- Family Admin Info -->
        <div class="card">
        <div class="card-body">
            <h5 class="card-title">Family Overview</h5>
            <p>
            Welcome, Family Admin! Here you can manage all activities related to your family:
            </p>
            <ul class="small">
            <li>Register new family members and assign roles</li>
            <li>View your family tree and family list</li>
            <li>Schedule meetings and set reminders for members</li>
            <li>Track payment history for subscriptions and packages</li>
            <li>Generate reports for family activities</li>
            </ul>
            <p class="mt-2">
            <strong>Tip:</strong> Click on the cards above to quickly navigate to different sections!
            </p>
        </div>
        </div>

    </div>
  </section>

</main>

<!-- Google Translate Element -->
<div id="google_translate_element" style="visibility: hidden; position: absolute; z-index: -1;"></div>

<script>
function googleTranslateElementInit() {
  new google.translate.TranslateElement({
    pageLanguage: 'en',
    includedLanguages: 'en,sw',
    autoDisplay: false
  }, 'google_translate_element');

  var savedLang = localStorage.getItem("selectedLanguage");
  if (savedLang) {
    setTimeout(function () {
      setLanguage(savedLang);
    }, 800);
  }
}

function changeLanguage(lang) {
  localStorage.setItem("selectedLanguage", lang);
  setLanguage(lang);
}

function setLanguage(lang) {
  var select = document.querySelector(".goog-te-combo");
  if (select) {
    select.value = lang;
    select.dispatchEvent(new Event("change"));
  } else {
    setTimeout(function () {
      setLanguage(lang);
    }, 300);
  }
}
</script>

