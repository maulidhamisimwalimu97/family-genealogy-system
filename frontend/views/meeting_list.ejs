<%- include('partials/title') %>
   <style>
  #main.main {
    padding: 20px;
    transition: all 0.3s;
  }

  /* Force responsive container */
  .table-responsive {
    display: block !important;
    width: 100% !important;
    overflow-x: auto !important;
    -webkit-overflow-scrolling: touch;
    margin-bottom: 15px;
  }

  #meetingTable {
    width: 100% !important;
    border-collapse: collapse !important;
  }

  #meetingTable th, #meetingTable td {
    white-space: nowrap !important;
    padding: 12px 15px !important;
  }

  /* MAREKEBISHO KWA SIMU */
  @media (max-width: 768px) {
    #main.main {
      padding: 10px !important;
    }
    
    /* Hii inalazimisha table kuwa na upana mkubwa ili scroll itokee */
    .dataTables_scrollBody #meetingTable, 
    .table-responsive #meetingTable {
      min-width: 900px !important; 
    }
    
    /* Inaficha scrollbar ya browser na kutumia ya DataTable */
