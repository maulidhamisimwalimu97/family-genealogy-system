<%- include('partials/header') %>
<%- include('partials/notifications') %>


<main id="main" class="main">
  <%- include('partials/notifications') %>

  <div class="pagetitle">
    <h1>Meeting List</h1>
  </div>

  <section class="section">
    <div class="card">
      <div class="card-body">
        <h5 class="card-title">Scheduled Meetings</h5>

        <div class="table-responsive">
          <table id="meetingTable" class="table table-hover table-bordered align-middle">
            <thead class="table-dark text-nowrap">
              <tr>
                <th>#</th>
                <th>Title</th>
                <th>Date</th>
                <th>Time</th>
                <th>Location/Link</th>
                <th class="text-center">Action</th>
              </tr>
            </thead>
              <tbody>
                <% if (meetings && meetings.length > 0) { %>
                  <% meetings.forEach((m, i) => { %>
                    <tr id="row-<%= m.meeting_id %>">
                      <td><%= i + 1 %></td>
                      <td class="fw-bold"><%= m.title %></td>
                      <td><%= m.meeting_date.toISOString().split('T')[0] %></td>
                      <td><%= m.meeting_time %></td>
                      <td>
                        <span class="text-truncate d-inline-block" style="max-width: 150px;">
                          <%= m.location || 'N/A' %>
                        </span>
                      </td>
                      <td>
                        <div class="d-flex gap-1 justify-content-center">
                          <button type="button" class="btn btn-sm btn-outline-info edit-btn"
                            data-id="<%= m.meeting_id %>"
                            data-title="<%= m.title %>"
                            data-date="<%= m.meeting_date.toISOString().split('T')[0] %>"
                            data-time="<%= m.meeting_time %>"
                            data-loc="<%= m.location %>">
                            <i class="bi bi-eye"></i>
                          </button>

                          <% if(m.location && m.location.startsWith('http')) { %>
                            <a href="<%= m.location %>" target="_blank" class="btn btn-sm btn-success">Join</a>
                          <% } %>

                          <button class="btn btn-sm btn-outline-danger"
                            onclick="deleteMeeting('<%= m.meeting_id %>', '<%= m.title %>')">
                            <i class="bi bi-trash"></i>
                          </button>
                        </div>
                      </td>
                    </tr>
                  <% }) %>

                <% } else { %>

                  <!-- 🔥 EMPTY STATE -->
                  <tr>
                    <td colspan="6" class="text-center py-4">
                      <i class="bi bi-calendar-x text-muted" style="font-size: 30px;"></i>
                      <p class="mt-2 text-muted">No upcoming meetings</p>
                    </td>
                  </tr>

                <% } %>
              </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>
</main>

<div class="modal fade" id="editMeetingModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title">Edit Meeting Details</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <form id="editMeetingForm">
        <div class="modal-body">
          <input type="hidden" id="m_id">
          <div class="mb-3">
            <label class="form-label">Title</label>
            <input type="text" id="m_title" class="form-control" required>
          </div>
          <div class="row">
            <div class="col-6 mb-3">
              <label class="form-label">Date</label>
              <input type="date" id="m_date" class="form-control" required>
            </div>
            <div class="col-6 mb-3">
              <label class="form-label">Time</label>
              <input type="time" id="m_time" class="form-control" required>
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label">Location / Link</label>
            <input type="text" id="m_loc" class="form-control" placeholder="Physical location or URL">
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
          <button type="submit" class="btn btn-primary">Save Changes</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    // 1. Initialize Meeting DataTable
    const meetingTableElement = document.querySelector("#meetingTable");
    let dataTable;
    
    if (meetingTableElement) {
      dataTable = new simpleDatatables.DataTable(meetingTableElement, {
        perPage: 5,
        searchable: true,
        fixedHeight: false
      });

      // 2. SIKILIZA CLICK KWENYE JICHO (Hata ukibadili page)
      // Tunatumia "Event Delegation" kwenye body ya table
      meetingTableElement.querySelector('tbody').addEventListener('click', function(e) {
        // Angalia kama aliyebonyezwa ni button ya jicho au icon ndani yake
        const btn = e.target.closest('.edit-btn');
        
        if (btn) {
          e.preventDefault();
          openMeetingModal(btn);
        }
      });
    }

    // 3. FUNCTION YA KUFUNGUA MODAL
    function openMeetingModal(btn) {
      const modalEl = document.getElementById('editMeetingModal');
      if (!modalEl) return;

      const editModal = new bootstrap.Modal(modalEl);

      // Chukua data kutoka kwenye attributes za button
      document.getElementById('m_id').value = btn.getAttribute('data-id') || '';
      document.getElementById('m_title').value = btn.getAttribute('data-title') || '';
      document.getElementById('m_date').value = btn.getAttribute('data-date') || '';
      document.getElementById('m_time').value = btn.getAttribute('data-time') || '';
      document.getElementById('m_loc').value = btn.getAttribute('data-loc') || '';

      editModal.show();
    }

    // 4. SAVE CHANGES (Update via Fetch)
    const editForm = document.getElementById('editMeetingForm');
    if (editForm) {
      editForm.addEventListener('submit', function(e) {
        e.preventDefault();
        const id = document.getElementById('m_id').value;
        const payload = {
          title: document.getElementById('m_title').value,
          meeting_date: document.getElementById('m_date').value,
          meeting_time: document.getElementById('m_time').value,
          location: document.getElementById('m_loc').value
        };

        fetch(`/update-meeting/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        })
        .then(res => res.json())
        .then(res => {
          if (res.success) window.location.reload();
        })
        .catch(err => console.error("Error updating:", err));
      });
    }
  });

  // 5. DELETE FUNCTION (Iweke nje ili onclick="deleteMeeting" ifanye kazi)
  function deleteMeeting(id, title) {
    if (confirm(`Are you sure you want to delete "${title}"?`)) {
      fetch(`/delete-meeting/${id}`, { method: 'DELETE' })
      .then(res => res.json())
      .then(res => {
        if (res.success) window.location.reload();
      });
    }
  }
</script>
<!-- Google Translate Element -->
<div id="google_translate_element" style="visibility: hidden; position: absolute; z-index: -1;"></div>

<script>
function googleTranslateElementInit() {
  new google.translate.TranslateElement({
    pageLanguage: 'en',
    includedLanguages: 'en,sw',
    autoDisplay: false
  }, 'google_translate_element');

  var savedLang = localStorage.getItem("selectedLanguage");
  if (savedLang) {
    setTimeout(function () {
      setLanguage(savedLang);
    }, 800);
  }
}

function changeLanguage(lang) {
  localStorage.setItem("selectedLanguage", lang);
  setLanguage(lang);
}

function setLanguage(lang) {
  var select = document.querySelector(".goog-te-combo");
  if (select) {
    select.value = lang;
    select.dispatchEvent(new Event("change"));
  } else {
    setTimeout(function () {
      setLanguage(lang);
    }, 300);
  }
}
</script>
