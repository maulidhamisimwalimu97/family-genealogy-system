<div class="card-body">

<h5 class="card-title">Upload New File</h5>

<form class="row g-3">

<!-- File Upload Area -->
<div class="col-12">

<div class="upload-box text-center p-5">

<i class="bi bi-cloud-arrow-up fs-1 text-primary"></i>

<p class="mt-3">
Drag & Drop files here
</p>

<p class="text-muted small">
or click to browse files
</p>

<input type="file" class="form-control mt-3">

</div>

</div>


<!-- File Name -->
<div class="col-md-6">
<label class="form-label">File Name</label>
<input type="text" class="form-control" placeholder="Enter file name">
</div>


<!-- Folder -->
<div class="col-md-6">
<label class="form-label">Select Folder</label>

<select class="form-select">
<option>General</option>
<option>Family Events</option>
<option>Meetings</option>
<option>Photos</option>
<option>Documents</option>
</select>

</div>


<!-- Description -->
<div class="col-12">
<label class="form-label">Description</label>

<textarea class="form-control" rows="3" placeholder="Write file description..."></textarea>

</div>


<!-- Visibility -->
<div class="col-md-6">

<label class="form-label">Visibility</label>

<select class="form-select">
<option>All Family Members</option>
<option>Admins Only</option>
<option>Adults Only</option>
</select>

</div>


<!-- File Preview -->
<div class="col-12">

<div class="card preview-box">

<div class="card-body">

<h6>File Preview</h6>

<div class="d-flex align-items-center">

<i class="bi bi-file-earmark fs-2 me-3"></i>

<div>

<strong>example_document.pdf</strong>

<p class="small text-muted mb-0">
Size: 2MB
</p>

</div>

</div>

</div>

</div>

</div>


<!-- Progress Bar -->
<div class="col-12">

<label class="form-label">Upload Progress</label>

<div class="progress">
<div class="progress-bar progress-bar-striped progress-bar-animated" style="width:40%">
40%
</div>
</div>

</div>


<!-- Buttons -->
<div class="col-12 text-end">

<button type="reset" class="btn btn-secondary">
Cancel
</button>

<button type="submit" class="btn btn-primary">
<i class="bi bi-upload"></i> Upload File
</button>

</div>


</form>

</div>
</div>

</div>

</div>

</section>

</main>
<!-- Google Translate Element -->
<div id="google_translate_element" style="visibility: hidden; position: absolute; z-index: -1;"></div>

<script>
function googleTranslateElementInit() {
  new google.translate.TranslateElement({
    pageLanguage: 'en',
    includedLanguages: 'en,sw',
    autoDisplay: false
  }, 'google_translate_element');

  var savedLang = localStorage.getItem("selectedLanguage");
  if (savedLang) {
    setTimeout(function () {
      setLanguage(savedLang);
    }, 800);
  }
}

function changeLanguage(lang) {
  localStorage.setItem("selectedLanguage", lang);
  setLanguage(lang);
}

function setLanguage(lang) {
  var select = document.querySelector(".goog-te-combo");
  if (select) {
    select.value = lang;
    select.dispatchEvent(new Event("change"));
  } else {
    setTimeout(function () {
      setLanguage(lang);
    }, 300);
  }
}
</script>
