<script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
<script src="https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap5.min.js"></script>

<script>
  $(document).ready(function() {
    var table = $('#familyTable').DataTable({
      responsive: false, // Tunatumia scrollX badala ya responsive dots
      scrollX: true,
      scrollCollapse: true,
      paging: true,
      searching: true,
      ordering: true,
      autoWidth: false, // Muhimu kuzuia DataTable isivuruge upana wa column
      columnDefs: [
        { width: "50px", targets: 0 },  // Width ya #
        { width: "200px", targets: 1 }, // Width ya Full Name
        { orderable: false, targets: -1 } 
      ]
    });

    // Hii inahakikisha Heading na Body zinalingana vizuri
    $(window).on('resize', function() {
        table.columns.adjust();
    });
  });
</script>

<!-- Google Translate Element -->
<div id="google_translate_element" style="visibility: hidden; position: absolute; z-index: -1;"></div>

<script>
function googleTranslateElementInit() {
  new google.translate.TranslateElement({
    pageLanguage: 'en',
    includedLanguages: 'en,sw',
    autoDisplay: false
  }, 'google_translate_element');

  var savedLang = localStorage.getItem("selectedLanguage");
  if (savedLang) {
    setTimeout(function () {
      setLanguage(savedLang);
    }, 800);
  }
}

function changeLanguage(lang) {
  localStorage.setItem("selectedLanguage", lang);
  setLanguage(lang);
}

function setLanguage(lang) {
  var select = document.querySelector(".goog-te-combo");
  if (select) {
    select.value = lang;
    select.dispatchEvent(new Event("change"));
  } else {
    setTimeout(function () {
      setLanguage(lang);
    }, 300);
  }
}
</script>
