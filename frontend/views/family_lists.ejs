<!-- Initialize DataTable -->
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const familyTable = document.querySelector("#familyTable");
    if (familyTable) {
      new simpleDatatables.DataTable(familyTable, {
        searchable: true,
        fixedHeight: false,
        perPage: 5,
        perPageSelect: [5, 10, 25, 50]
      });
    }
  });
</script>

