<body>

  <!-- ======= Header ======= -->
  <%- include('partials/title') %>
<style>
  #main.main { padding: 20px; transition: all 0.3s; }

  /* Container ya kiscroll */
  .table-responsive {
    width: 100%;
    margin-bottom: 15px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border: 1px solid #dee2e6;
  }

  /* Force table layout */
  #familyTable {
    width: 100% !important;
    margin: 0 !important;
    border-collapse: collapse !important;
  }

  /* Hakikisha maandishi hayashuki chini (Wrap) */
  #familyTable th, #familyTable td {
    white-space: nowrap !important;
    text-align: left;
    padding: 12px 15px !important;
  }

  .table-dark th {
    background-color: #2b2f33 !important;
    border-color: #373b3e !important;
    color: #fff !important;
  }

  /* Responsive Adjustments */
  @media (max-width: 768px) {
    #main.main { padding: 10px !important; }
    
    /* Tunalazimisha upana mkubwa kwenye simu ili kiscroll kifanye kazi */
    #familyTable {
      min-width: 900px !important; 
    }
    
    .pagetitle h1 { font-size: 1.2rem; }
  }

  /* Fix for alignment on large screens */
  @media (min-width: 992px) {
    .table-responsive {
      overflow-x: auto; /* Inaruhusu scroll kama columns ni nyingi */
    }
  }
</style>

  </header><!-- End Header -->

<%- include('partials/header') %>
<main id="main" class="main">
  <%- include('partials/notifications') %>

  <div class="pagetitle">
    <h1>Family Members List</h1>
  </div>

  <section class="section">
    <div class="row">
      <div class="col-12">
        <div class="card">
          <div class="card-body pt-3">
            <h5 class="card-title">Registered Members</h5>

            <div class="table-responsive">
              <table id="familyTable" class="table table-hover table-bordered align-middle">
                <thead class="table-dark text-nowrap">
                  <tr>
                    <th>#</th>
                    <th>Full Name</th>
                    <th>Gender</th>
                    <th>Relationship</th>
                    <th>Role</th>
                    <th>Phone</th>
                    <th>Branch</th>
                    <th class="text-center">Action</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (members && members.length > 0) { %>
                    <% members.forEach((member, index) => { %>
                      <tr id="row-<%= member.member_id %>">
                        <td><%= index + 1 %></td>
                        <td class="fw-bold"><%= member.full_name %></td>
                        <td class="text-capitalize"><%= member.gender %></td>
                        <td><%= member.relationship || 'N/A' %></td>
                        <td>
                          <span class="badge <%= member.role === 'family_admin' ? 'bg-primary' : 'bg-secondary' %>">
                            <%= member.role %>
                          </span>
                        </td>
                        <td><%= member.phone || '-' %></td>
                        <td><%= member.branch_type || 'Main' %></td>
                        <td>
                          <div class="action-buttons d-flex gap-2 justify-content-center">

                            <!-- VIEW BUTTON -->
                            <button 
                              class="btn btn-sm btn-outline-info"
                              onclick="viewMember(this)"
                              data-name="<%= member.full_name %>"
                              data-gender="<%= member.gender %>"
                              data-relationship="<%= member.relationship %>"
                              data-role="<%= member.role %>"
                              data-phone="<%= member.phone %>"
                              data-branch="<%= member.branch_type %>">
                              <i class="bi bi-eye"></i>
                            </button>

                            <!-- EDIT BUTTON -->
                            <button 
                              class="btn btn-sm btn-outline-warning"
                              onclick="editMember(this)"
                              data-id="<%= member.member_id %>"
                              data-name="<%= member.full_name %>"
                              data-phone="<%= member.phone %>">
                              <i class="bi bi-pencil"></i>
                            </button>

                            <!-- DELETE -->
                            <button 
                              class="btn btn-sm btn-outline-danger" 
                              onclick="deleteMember('<%= member.member_id %>', '<%= member.full_name %>')">
                              <i class="bi bi-trash"></i>
                            </button>

                          </div>
                        </td>
                      </tr>
                    <% }); %>
                  <% } else { %>
                    <tr>
                      <td colspan="8" class="text-center py-4">No members found.</td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>

          </div>
        </div>
      </div>
    </div>
  </section>
</main>

<!-- ✅ MODAL -->
<div class="modal fade" id="memberModal">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">

      <div class="modal-header">
        <h5 class="modal-title" id="modalTitle">Member</h5>
        <button class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body" id="modalBody"></div>

    </div>
  </div>
</div>

<!-- ✅ SCRIPTS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
const modal = new bootstrap.Modal(document.getElementById('memberModal'));

// VIEW
function viewMember(btn) {
  document.getElementById('modalTitle').innerText = "View Member";

  const html = `
    <div class="row">
      <div class="col-md-6">
        <p><strong>Name:</strong> ${btn.dataset.name}</p>
        <p><strong>Gender:</strong> ${btn.dataset.gender}</p>
        <p><strong>Relationship:</strong> ${btn.dataset.relationship || 'N/A'}</p>
      </div>
      <div class="col-md-6">
        <p><strong>Role:</strong> ${btn.dataset.role}</p>
        <p><strong>Phone:</strong> ${btn.dataset.phone || '-'}</p>
        <p><strong>Branch:</strong> ${btn.dataset.branch || 'Main'}</p>
      </div>
    </div>
  `;

  document.getElementById('modalBody').innerHTML = html;
  modal.show();
}

// EDIT
function editMember(btn) {
  document.getElementById('modalTitle').innerText = "Edit Member";

  const html = `
    <form onsubmit="saveEdit(event)">
      <input type="hidden" id="editId" value="${btn.dataset.id}">

      <div class="mb-3">
        <label>Name</label>
        <input type="text" id="editName" class="form-control" value="${btn.dataset.name}">
      </div>

      <div class="mb-3">
        <label>Phone</label>
        <input type="text" id="editPhone" class="form-control" value="${btn.dataset.phone}">
      </div>

      <button class="btn btn-primary w-100">Save Changes</button>
    </form>
  `;

  document.getElementById('modalBody').innerHTML = html;
  modal.show();
}

// SAVE (UI ONLY)
function saveEdit(e) {
  e.preventDefault();

  const id = document.getElementById('editId').value;
  const name = document.getElementById('editName').value;
  const phone = document.getElementById('editPhone').value;

  fetch(`/update-member/${id}`, {
    method: 'PUT',
    headers: {
      'Content-Type': 'application/json'
    },
    body: JSON.stringify({ name, phone })
  })
  .then(res => res.json())
  .then(data => {
    if (data.success) {
      // 🔥 reload page so notification partial shows
      window.location.reload();
    } else {
      Swal.fire('Error!', 'Failed to update member', 'error');
    }
  })
  .catch(() => {
    Swal.fire('Error!', 'Server error', 'error');
  });
}
</script>
<!-- ======= DataTables & Responsive Scripts ======= -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css">

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
