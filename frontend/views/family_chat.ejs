<body>

  <!-- ======= Header ======= -->

<%- include('partials/title') %>
<%- include('partials/header') %>
<%- include('partials/notifications.ejs') %>

<main id="main" class="main">
  <div class="pagetitle"><h1>Family Group</h1></div>

  <section class="section">
    <div class="row justify-content-center">
      <div class="col-xl-10 col-lg-12">
        <div class="card shadow-sm border-0">
          
          <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center cursor-pointer" data-bs-toggle="modal" data-bs-target="#membersModal" style="cursor: pointer;">
              <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 48px; height: 48px; font-weight: bold;">
                  <%= family.family_name.charAt(0) %>
              </div>
              <div>
                <h6 class="mb-0 fw-bold"><%= family.family_name %> Group</h6>
                <small class="text-primary text-decoration-underline"><%= family.total_members %> Members (See all)</small>
              </div>
            </div>
          </div>

          <div class="card-body bg-light chat-scroll" id="chatContainer" style="height: 60vh; overflow-y: auto; background-image: url('https://www.transparenttextures.com/patterns/cubes.png');">
            <div class="d-flex flex-column gap-3 p-3">
              <% messages.forEach(msg => { %>
                <div class="d-flex flex-column <%= msg.sender_id == memberId ? 'align-items-end' : 'align-items-start' %>">
                  
                  <small class="fw-bold mb-1 px-2 <%= msg.sender_id == memberId ? 'text-success' : 'text-primary' %>">
                   <%= msg.first_name %> (<%= msg.sender_role %>)
                  </small>

                  <div class="p-3 shadow-sm" style="max-width: 85%; border-radius: 15px; <%= msg.sender_id == memberId ? 'background: #dcf8c6; border-bottom-right-radius: 2px;' : 'background: white; border-bottom-left-radius: 2px;' %>">
                    <%= msg.message %>
                    
                    <div class="d-flex align-items-center justify-content-end mt-1" style="font-size: 0.65rem; opacity: 0.7;">
                      <span class="me-1"><%= new Date(msg.sent_at).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %></span>
                      
                      <% if (msg.sender_id == memberId) { %>
                        <% if (msg.read_count >= family.total_members - 1) { %>
                           <i class="bi bi-check2-all text-primary"></i>
                        <% } else if (msg.read_count > 0) { %>
                           <i class="bi bi-check2-all text-muted"></i>
                        <% } else { %>
                           <i class="bi bi-check2 text-muted"></i>
                        <% } %>
                      <% } %>
                    </div>
                  </div>
                </div>
              <% }); %>
            </div>
          </div>

          <div class="card-footer bg-white py-3">
            <form action="/send_group_message" method="POST" class="d-flex gap-2">
              <input type="text" name="message" class="form-control rounded-pill border-0 bg-light px-4" placeholder="Andika ujumbe..." required autocomplete="off">
              <button type="submit" class="btn btn-success rounded-circle px-3"><i class="bi bi-send-fill"></i></button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="modal fade" id="membersModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-md">
      <div class="modal-content border-0 shadow">
        <div class="modal-header bg-light">
          <h5 class="modal-title fw-bold">Family Members</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body p-0" style="max-height: 400px; overflow-y: auto;">
          <div class="list-group list-group-flush">
            <% allMembers.forEach(member => { %>
              <a href="/member_profile/<%= member.member_id %>" class="list-group-item list-group-item-action d-flex align-items-center py-3">
                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                  <%= member.first_name.charAt(0) %>
                </div>
                <div class="flex-grow-1">
                  <h6 class="mb-0 fw-bold text-dark"><%= member.first_name %> <%= member.last_name %></h6>
                  <small class="text-muted"><%= member.relationship %> | <%= member.role %></small>
                </div>
                <i class="bi bi-chevron-right text-muted"></i>
              </a>
            <% }); %>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>

<style>
  .chat-scroll { scroll-behavior: smooth; }
  .cursor-pointer:hover { background-color: #f8f9fa; }
</style>

<script>
  // Auto-scroll kwenda chini
  document.addEventListener("DOMContentLoaded", function() {
    const chatBox = document.getElementById('chatContainer');
    chatBox.scrollTop = chatBox.scrollHeight;
  });
</script>

<!-- Google Translate Element -->
<div id="google_translate_element" style="visibility: hidden; position: absolute; z-index: -1;"></div>

<script>
function googleTranslateElementInit() {
  new google.translate.TranslateElement({
    pageLanguage: 'en',
    includedLanguages: 'en,sw',
    autoDisplay: false
  }, 'google_translate_element');

  var savedLang = localStorage.getItem("selectedLanguage");
  if (savedLang) {
    setTimeout(function () {
      setLanguage(savedLang);
    }, 800);
  }
}

function changeLanguage(lang) {
  localStorage.setItem("selectedLanguage", lang);
  setLanguage(lang);
}

function setLanguage(lang) {
  var select = document.querySelector(".goog-te-combo");
  if (select) {
    select.value = lang;
    select.dispatchEvent(new Event("change"));
  } else {
    setTimeout(function () {
      setLanguage(lang);
    }, 300);
  }
}
</script>
