<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">

  <title>Family Chats Group</title>
  <meta content="Family Admin Panel for managing family genealogy records" name="description">
  <meta content="family, genealogy, admin, lineage" name="keywords">

  <!-- Favicons -->


  <!-- Google Fonts -->
  <link href="https://fonts.gstatic.com" rel="preconnect">
  <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,300i,400,400i,600,600i,700,700i|Nunito:300,300i,400,400i,600,600i,700,700i|Poppins:300,300i,400,400i,500,500i,600,600i,700,700i" rel="stylesheet">

  <!-- Vendor CSS Files -->
  <link href="/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
  <link href="/assets/vendor/boxicons/css/boxicons.min.css" rel="stylesheet">
  <link href="/assets/vendor/quill/quill.snow.css" rel="stylesheet">
  <link href="/assets/vendor/quill/quill.bubble.css" rel="stylesheet">
  <link href="/assets/vendor/remixicon/remixicon.css" rel="stylesheet">
  <link href="/assets/vendor/simple-datatables/style.css" rel="stylesheet">

  <!-- Main CSS File -->
  <link href="assets/css/style.css" rel="stylesheet">
  <link href="/assets/css/dark.css" rel="stylesheet">
</head>

<body>

  <!-- ======= Header ======= -->
<%- include('partials/title') %>
<%- include('partials/header') %>

<main id="main" class="main">
  <div class="pagetitle d-flex justify-content-between align-items-center">
    <h1>Family Group</h1>
  </div>

  <section class="section">
    <div class="row justify-content-center">
      <div class="col-xl-10 col-lg-12">
        <div class="card shadow-sm border-0">

          <!-- HEADER -->
          <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center cursor-pointer" data-bs-toggle="modal" data-bs-target="#membersModal">
              <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center me-3 shadow-sm" style="width:48px;height:48px;font-weight:bold;">
                <%= family.family_name.charAt(0) %>
              </div>
              <div>
                <h6 class="mb-0 fw-bold text-dark"><%= family.family_name %></h6>
                <small class="text-primary text-decoration-underline"><%= family.total_members %> Members</small>
              </div>
            </div>
          </div>

          <!-- CHAT -->
          <div class="card-body bg-light chat-scroll" style="height:60vh;overflow-y:auto;">
            <div class="d-flex flex-column gap-3 p-3">
              <% messages.forEach(msg => { %>
                <% const isMe = msg.sender_id === memberId; %>
                <div class="d-flex flex-column <%= isMe ? 'align-items-end' : 'align-items-start' %>">
                  <small class="fw-bold mb-1 px-2 <%= isMe ? 'text-success' : 'text-primary' %>"><%= msg.first_name %></small>
                  <div class="p-3 shadow-sm <%= isMe ? 'bg-success-subtle' : 'bg-white' %>" style="max-width:85%;border-radius:15px;">
                    <%= msg.message || '' %>
                    <% if(msg.image){ %>
                      <img src="/uploads/images/<%= msg.image %>" style="max-width:120px;display:block;margin-top:5px;border-radius:8px;">
                    <% } %>
                  </div>
                  <small class="text-muted" style="font-size:0.7rem;"><%= msg.sent_at ? new Date(msg.sent_at).toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'}) : '' %></small>
                </div>
              <% }); %>
            </div>
          </div>

          <!-- FOOTER -->
          <div class="card-footer bg-white py-3 d-flex gap-2 align-items-center">
            <form action="/send_group_message" method="POST" enctype="multipart/form-data" class="d-flex gap-2 align-items-center w-100">
              <input type="text" name="message" class="form-control rounded-pill bg-light" placeholder="Andika ujumbe..." required>
              <input type="file" name="image" id="imageInput" hidden>
  
              <button type="submit" class="btn btn-success rounded-circle px-3"><i class="bi bi-send-fill"></i></button>
            </form>
            <button type="button" id="emojiBtn" class="btn btn-light">😊</button>
          </div>
          <div id="emojiPicker" class="p-2 bg-light border rounded shadow-sm" style="position:absolute;display:none;"></div>

        </div>
      </div>
    </div>
  </section>

  <!-- MEMBERS MODAL -->
  <div class="modal fade" id="membersModal">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header">
          <h5>Family Members</h5>
          <button class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="row">
            <% allMembers.forEach(member => { %>
              <div class="col-6 col-md-4 mb-2">
                <div class="card p-2 text-center shadow-sm">
                  <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center mx-auto mb-1" style="width:40px;height:40px;">
                    <%= member.first_name.charAt(0) %>
                  </div>
                  <small class="fw-bold"><%= member.first_name %> <%= member.last_name %></small><br>
                  <small class="text-muted"><%= member.role %></small>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>

<script>
const emojis = ['😀','😂','😍','😎','🤔','😭','👍','🙏'];
const emojiBtn = document.getElementById('emojiBtn');
const emojiPicker = document.getElementById('emojiPicker');
const messageInput = document.querySelector('input[name="message"]');

emojiBtn.addEventListener('click', () => {
  emojiPicker.style.display = emojiPicker.style.display==='none'?'block':'none';
  emojiPicker.innerHTML = emojis.map(e=>`<button type="button" class="btn btn-light btn-sm m-1" onclick="addEmoji('${e}')">${e}</button>`).join('');
});

function addEmoji(e){
  messageInput.value += e;
}
</script>

<!-- Google Translate Element -->
<div id="google_translate_element" style="visibility: hidden; position: absolute; z-index: -1;"></div>

<script>
function googleTranslateElementInit() {
  new google.translate.TranslateElement({
    pageLanguage: 'en',
    includedLanguages: 'en,sw',
    autoDisplay: false
  }, 'google_translate_element');

  var savedLang = localStorage.getItem("selectedLanguage");
  if (savedLang) {
    setTimeout(function () {
      setLanguage(savedLang);
    }, 800);
  }
}

function changeLanguage(lang) {
  localStorage.setItem("selectedLanguage", lang);
  setLanguage(lang);
}

function setLanguage(lang) {
  var select = document.querySelector(".goog-te-combo");
  if (select) {
    select.value = lang;
    select.dispatchEvent(new Event("change"));
  } else {
    setTimeout(function () {
      setLanguage(lang);
    }, 300);
  }
}
</script>

<!-- ======= Footer ======= -->
    <footer id="footer" class="footer">
    <div class="copyright">
        &copy; Copyright <strong><span>Family Genealogy System</span></strong>. All Rights Reserved
    </div>
    <div class="credits">
        Developed by <strong>Maulid Mwalimu</strong>
    </div>
    </footer>
    <!-- End Footer -->

  <a href="#" class="back-to-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>

  <!-- Vendor JS Files -->
  <script src="/assets/vendor/apexcharts/apexcharts.min.js"></script>
  <script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script src="/assets/vendor/chart.js/chart.umd.js"></script>
  <script src="/assets/vendor/echarts/echarts.min.js"></script>
  <script src="/assets/vendor/quill/quill.js"></script>
  <script src="/assets/vendor/simple-datatables/simple-datatables.js"></script>
  <script src="/assets/vendor/tinymce/tinymce.min.js"></script>
  <script src="/assets/vendor/php-email-form/validate.js"></script>
  <script src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>

  <!-- Main JS File -->
  <script src="/assets/js/main.js"></script>

</body>

</html>