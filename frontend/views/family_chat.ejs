</head>

<body>

  <!-- ======= Header ======= -->
<%- include('partials/title') %>
<%- include('partials/header') %>

<%- include('partials/title') %>
<%- include('partials/header') %>

<main id="main" class="main">

  <div class="pagetitle d-flex justify-content-between align-items-center">
    <h1>Family Group</h1>
  </div>

  <section class="section">
    <div class="row justify-content-center">
      <div class="col-xl-10 col-lg-12">

        <div class="card shadow-sm border-0">

          <!-- HEADER -->
          <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            
            <!-- LEFT -->
            <div class="d-flex align-items-center cursor-pointer" data-bs-toggle="modal" data-bs-target="#membersModal">

              <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center me-3 shadow-sm"
                   style="width:48px;height:48px;font-weight:bold;">
                <%= (family && family.family_name) ? family.family_name.charAt(0) : 'F' %>
              </div>

              <div>
                <h6 class="mb-0 fw-bold text-dark">
                  <%= (family && family.family_name) ? family.family_name : 'Family Group' %>
                </h6>
                <small class="text-primary text-decoration-underline">
                  <%= (family && family.total_members) ? family.total_members : 0 %> Members
                </small>
              </div>
            </div>

            <!-- RIGHT 3 DOT MENU -->
            <div class="dropdown">
              <button class="btn btn-light border-0" data-bs-toggle="dropdown">
                <i class="bi bi-three-dots-vertical fs-5"></i>
              </button>

              <ul class="dropdown-menu dropdown-menu-end shadow-sm">

                <% if (profile.role === 'Admin') { %>

                  <li>
                    <a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#settingsModal">
                      ⚙️ Group Settings
                    </a>
                  </li>

                  <li>
                    <a class="dropdown-item" href="/toggle_chat">
                      🚫 Toggle Chat Restriction
                    </a>
                  </li>

                <% } else { %>

                  <li>
                    <span class="dropdown-item text-muted">
                      Admin only settings
                    </span>
                  </li>

                <% } %>

              </ul>
            </div>

          </div>

          <!-- CHAT -->
          <div class="card-body bg-light chat-scroll" id="chatContainer"
               style="height:60vh;overflow-y:auto;">

            <div class="d-flex flex-column gap-3 p-3">

              <% (messages || []).forEach(function(msg){ %>

                <% var isMe = msg.sender_id == memberId; %>
                <% var readCount = msg.read_count || 0; %>

                <div class="d-flex flex-column <%= isMe ? 'align-items-end' : 'align-items-start' %>">

                  <small class="fw-bold mb-1 px-2 <%= isMe ? 'text-success' : 'text-primary' %>">
                    <%= msg.first_name || 'User' %>
                  </small>

                  <div class="p-3 shadow-sm <%= isMe ? 'bg-success-subtle' : 'bg-white' %>"
                       style="max-width:85%;border-radius:15px;">

                    <%= msg.message || '' %>

                    <div class="text-end" style="font-size:0.7rem;">
                      <%= msg.sent_at ? new Date(msg.sent_at).toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'}) : '' %>

                      <% if (isMe) { %>
                        <% if (readCount >= ((family.total_members || 1) - 1)) { %>
                          ✔✔
                        <% } else { %>
                          ✔
                        <% } %>
                      <% } %>
                    </div>

                  </div>
                </div>

              <% }); %>

            </div>
          </div>

          <!-- FOOTER (RESTRICT CHAT) -->
          <% if (!family.only_admin_chat || profile.role === 'Admin') { %>

          <div class="card-footer bg-white py-3">
            <form action="/send_group_message" method="POST" class="d-flex gap-2">
              <input type="text" name="message" class="form-control rounded-pill bg-light" placeholder="Andika ujumbe..." required>
              <button class="btn btn-success rounded-circle px-3">
                <i class="bi bi-send-fill"></i>
              </button>
            </form>
          </div>

          <% } else { %>

          <div class="card-footer text-center text-muted">
            Only admin can send messages
          </div>

          <% } %>

        </div>
      </div>
    </div>
  </section>

  <!-- SETTINGS MODAL -->
  <div class="modal fade" id="settingsModal">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">

        <div class="modal-header">
          <h5>Group Settings</h5>
          <button class="btn-close" data-bs-dismiss="modal"></button>
        </div>

        <form action="/update_group_settings" method="POST">
          <div class="modal-body">

            <input type="text" name="family_name" class="form-control mb-3"
                   value="<%= family.family_name %>">

            <div class="form-check form-switch">
              <input class="form-check-input" type="checkbox" name="only_admin_chat"
                     <%= family.only_admin_chat ? 'checked' : '' %>>
              <label class="form-check-label">
                Only admin can send messages
              </label>
            </div>

          </div>

          <div class="modal-footer">
            <button class="btn btn-success w-100">Save</button>
          </div>
        </form>

      </div>
    </div>
  </div>

</main>

<script>
document.addEventListener("DOMContentLoaded", function () {
  var chatBox = document.getElementById('chatContainer');
  if (chatBox) chatBox.scrollTop = chatBox.scrollHeight;
});
</script>

<!-- Google Translate Element -->
<div id="google_translate_element" style="visibility: hidden; position: absolute; z-index: -1;"></div>

<script>
function googleTranslateElementInit() {
  new google.translate.TranslateElement({
    pageLanguage: 'en',
    includedLanguages: 'en,sw',
    autoDisplay: false
  }, 'google_translate_element');

  var savedLang = localStorage.getItem("selectedLanguage");
  if (savedLang) {
    setTimeout(function () {
      setLanguage(savedLang);
    }, 800);
  }
}

function changeLanguage(lang) {
  localStorage.setItem("selectedLanguage", lang);
  setLanguage(lang);
}

function setLanguage(lang) {
  var select = document.querySelector(".goog-te-combo");
  if (select) {
    select.value = lang;
    select.dispatchEvent(new Event("change"));
  } else {
    setTimeout(function () {
      setLanguage(lang);
    }, 300);
  }
}
</script>
<!-- ======= Footer ======= -->
    <footer id="footer" class="footer">
    <div class="copyright">
        &copy; Copyright <strong><span>Family Genealogy System</span></strong>. All Rights Reserved
    </div>
    <div class="credits">
        Developed by <strong>Maulid Mwalimu</strong>
    </div>
    </footer>
    <!-- End Footer -->

  <a href="#" class="back-to-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>

  <!-- Vendor JS Files -->
  <script src="/assets/vendor/apexcharts/apexcharts.min.js"></script>
  <script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script src="/assets/vendor/chart.js/chart.umd.js"></script>
  <script src="/assets/vendor/echarts/echarts.min.js"></script>
  <script src="/assets/vendor/quill/quill.js"></script>
  <script src="/assets/vendor/simple-datatables/simple-datatables.js"></script>
  <script src="/assets/vendor/tinymce/tinymce.min.js"></script>
  <script src="/assets/vendor/php-email-form/validate.js"></script>
  <script src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>

  <!-- Main JS File -->
  <script src="/assets/js/main.js"></script>

</body>

</html>