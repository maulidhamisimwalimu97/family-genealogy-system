    <main id="main" class="main">
    <div class="container-fluid">

        <!-- Page Title -->
        <div class="pagetitle mb-4">
        <h1>Paid Families</h1>
        <p class="text-muted">Families with completed payments</p>
        </div>

        <!-- Paid Families Card -->
        <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Paid Family List</h5>
            <span class="badge bg-success">Payment Completed</span>
        </div>

        <div class="card-body">
            <div class="table-responsive">
            <table id="paidFamiliesTable" class="table table-striped table-hover nowrap" style="width:100%">
                <thead>
                <tr>
                    <th>#</th>
                    <th>Family</th>
                    <th>Family Admin</th>
                    <th>Phone</th>
                    <th>Amount (TZS)</th>
                    <th>Method</th>
                    <th>Paid Date</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
                </thead>

                <tbody>
                  <% if (locals.paidFamilies && paidFamilies.length > 0) { %>
                    <% paidFamilies.forEach((record, index) => { %>
                      <tr>
                        <td><%= index + 1 %></td>
                        <td><%= record.family_name %></td>
                        <td><%= record.first_name %> <%= record.last_name %></td>
                        <td><%= record.phone %></td>
                        <td><%= Number(record.amount).toLocaleString() %></td>
                        <td>
                          <% if(record.payment_method === 'mobile_money') { %>
                            <span class="badge bg-info text-dark">Mobile Money</span>
                          <% } else if(record.payment_method === 'bank') { %>
                            <span class="badge bg-primary">Bank</span>
                          <% } else { %>
                            <span class="badge bg-secondary">Cash</span>
                          <% } %>
                        </td>
                        <td><%= new Date(record.payment_date).toLocaleDateString('en-CA') %></td> <td><span class="badge bg-success">Paid</span></td>
                        <td>
                          <button class="btn btn-sm btn-outline-primary" title="View Family">
                            <i class="bi bi-eye"></i>
                          </button>
                          <button class="btn btn-sm btn-outline-secondary" title="Receipt">
                            <i class="bi bi-receipt"></i>
                          </button>
                        </td>
                      </tr>
                    <% }); %>
                  <% } else { %>
                    <tr>
                      <td colspan="9" class="text-center table-danger text-danger py-4">
                        <i class="bi bi-exclamation-circle me-2"></i> No paid family records found.
                      </td>
                    </tr>
                  <% } %>
                </tbody>            
              </table>
            </div>
        </div>
        </div>

    </div>
    </main>



