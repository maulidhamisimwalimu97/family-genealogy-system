<div class="modal fade" id="viewModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title">Family Details</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="row g-3" id="viewDetails">
            </div>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="editModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <form action="/update-family" method="POST" class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Edit Family Information</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <input type="hidden" name="family_id" id="edit_id">
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label">Family Name</label>
            <input type="text" name="family_name" id="edit_name" class="form-control" required>
          </div>
          <div class="col-md-6">
            <label class="form-label">Tribe</label>
            <input type="text" name="tribe" id="edit_tribe" class="form-control">
          </div>
          <div class="col-md-6">
            <label class="form-label">Region</label>
            <input type="text" name="region" id="edit_region" class="form-control">
          </div>
          <div class="col-md-6">
            <label class="form-label">Religion</label>
            <input type="text" name="religion" id="edit_religion" class="form-control">
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="submit" class="btn btn-success">Save Changes</button>
      </div>
    </form>
  </div>
</div>

<form id="deleteForm" action="/delete-family" method="POST" style="display:none;">
    <input type="hidden" name="family_id" id="delete_id">
</form>

<script>
function viewFamily(data) {
    const fam = JSON.parse(data);
    document.getElementById('viewDetails').innerHTML = `
        <div class="col-6"><strong>Tribe:</strong><br>${fam.tribe}</div>
        <div class="col-6"><strong>Region:</strong><br>${fam.region}</div>
        <div class="col-12"><hr></div>
        <div class="col-6"><strong>Admin:</strong><br>${fam.first_name} ${fam.last_name}</div>
        <div class="col-6"><strong>Phone:</strong><br>${fam.phone}</div>
        <div class="col-12"><strong>Address:</strong><br>${fam.address || 'N/A'}</div>
    `;
    new bootstrap.Modal(document.getElementById('viewModal')).show();
}

function editFamily(data) {
    const fam = JSON.parse(data);
    document.getElementById('edit_id').value = fam.family_id;
    document.getElementById('edit_name').value = fam.family_name;
    document.getElementById('edit_tribe').value = fam.tribe;
    document.getElementById('edit_region').value = fam.region;
    document.getElementById('edit_religion').value = fam.religion;
    new bootstrap.Modal(document.getElementById('editModal')).show();
}

function confirmDelete(id, name) {
    if(confirm(`Are you sure you want to delete ${name}? This will remove all related members.`)) {
        document.getElementById('delete_id').value = id;
        document.getElementById('deleteForm').submit();
    }
}
</script>