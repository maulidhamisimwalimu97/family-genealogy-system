<main id="main" class="main">
<div class="pagetitle">
  <h1>Send Meeting Reminder</h1>
</div>

<section class="section">
  <div class="row">

    <!-- Reminder Form -->
    <div class="col-lg-8">
      <div class="card">
        <div class="card-body">

          <h5 class="card-title">Create Reminder</h5>

          <form>

            <!-- Select Meeting -->
            <div class="mb-3">
              <label class="form-label">
                Select Meeting <span class="text-danger">*</span>
              </label>
              <select class="form-select" required>
                <option value="">Choose Meeting</option>
                <option>Annual Family Meeting</option>
                <option>Branch B Planning</option>
                <option>Emergency Discussion</option>
              </select>
            </div>

            <!-- Reminder Type -->
            <div class="mb-3">
              <label class="form-label">
                Reminder Method <span class="text-danger">*</span>
              </label>
              <div class="form-check">
                <input class="form-check-input" type="checkbox" value="sms" id="smsCheck">
                <label class="form-check-label" for="smsCheck">
                  SMS Reminder
                </label>
              </div>
              <div class="form-check">
                <input class="form-check-input" type="checkbox" value="email" id="emailCheck">
                <label class="form-check-label" for="emailCheck">
                  Email Reminder
                </label>
              </div>
              <div class="form-check">
                <input class="form-check-input" type="checkbox" value="app" id="appCheck">
                <label class="form-check-label" for="appCheck">
                  In-App Notification
                </label>
              </div>
            </div>

            <!-- Recipients -->
            <div class="mb-3">
              <label class="form-label">
                Send To <span class="text-danger">*</span>
              </label>
              <select class="form-select" required>
                <option value="all">All Family Members</option>
                <option value="branch">Specific Branch</option>
                <option value="selected">Selected Members</option>
              </select>
            </div>

            <!-- Schedule Time -->
            <div class="row">
              <div class="col-md-6 mb-3">
                <label class="form-label">
                  Reminder Date <span class="text-danger">*</span>
                </label>
                <input type="date" class="form-control" required>
              </div>

              <div class="col-md-6 mb-3">
                <label class="form-label">
                  Reminder Time <span class="text-danger">*</span>
                </label>
                <input type="time" class="form-control" required>
              </div>
            </div>

            <!-- Custom Message -->
            <div class="mb-3">
              <label class="form-label">
                Custom Message
              </label>
              <textarea class="form-control" rows="4"
                placeholder="Example: Dear family member, this is a reminder for our upcoming meeting scheduled for..."></textarea>
            </div>

            <!-- Buttons -->
            <div class="text-end">
              <button type="reset" class="btn btn-secondary">Cancel</button>
              <button type="submit" class="btn btn-primary">
                Send Reminder
              </button>
            </div>

          </form>

        </div>
      </div>
    </div>

    <!-- Reminder History -->
    <div class="col-lg-4">
      <div class="card">
        <div class="card-body">

          <h5 class="card-title">Recent Reminders</h5>

          <ul class="list-group list-group-flush">

            <li class="list-group-item">
              <strong>Annual Meeting</strong><br>
              <small>SMS sent to 25 members</small><br>
              <span class="badge bg-success">Sent</span>
            </li>

            <li class="list-group-item">
              <strong>Branch Planning</strong><br>
              <small>Email sent to 10 members</small><br>
              <span class="badge bg-warning">Scheduled</span>
            </li>

            <li class="list-group-item">
              <strong>Emergency Meeting</strong><br>
              <small>App notification sent</small><br>
              <span class="badge bg-secondary">Completed</span>
            </li>

          </ul>

        </div>
      </div>
    </div>

  </div>
</section>
</main>
<!-- Google Translate Element -->
<div id="google_translate_element" style="visibility: hidden; position: absolute; z-index: -1;"></div>

<script>
function googleTranslateElementInit() {
  new google.translate.TranslateElement({
    pageLanguage: 'en',
    includedLanguages: 'en,sw',
    autoDisplay: false
  }, 'google_translate_element');

  var savedLang = localStorage.getItem("selectedLanguage");
  if (savedLang) {
    setTimeout(function () {
      setLanguage(savedLang);
    }, 800);
  }
}

function changeLanguage(lang) {
  localStorage.setItem("selectedLanguage", lang);
  setLanguage(lang);
}

function setLanguage(lang) {
  var select = document.querySelector(".goog-te-combo");
  if (select) {
    select.value = lang;
    select.dispatchEvent(new Event("change"));
  } else {
    setTimeout(function () {
      setLanguage(lang);
    }, 300);
  }
}
</script>
