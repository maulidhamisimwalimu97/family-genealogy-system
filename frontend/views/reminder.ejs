<body>

  <!-- ======= Header ======= -->
<%- include('partials/title') %>
<%- include('partials/header') %>

<main id="main" class="main">
  <div class="pagetitle">
    <h1>Send Meeting Reminder</h1>
  </div>

  <section class="section">
    <div class="row">
      <div class="col-lg-8">
        <div class="card">
          <div class="card-body">
            <h5 class="card-title">Create Reminder</h5>

            <form action="/send-reminder" method="POST">

              <div class="mb-3">
                <label class="form-label">Select Meeting <span class="text-danger">*</span></label>
                <select name="meeting_id" class="form-select" required>
                  <option value="">Choose Meeting</option>
                  <% meetings.forEach(meeting => { %>
                    <option value="<%= meeting.meeting_id %>"><%= meeting.title %> (<%= meeting.meeting_date.toISOString().split('T')[0] %>)</option>
                  <% }) %>
                </select>
              </div>

              <div class="mb-3">
                <label class="form-label">Reminder Method <span class="text-danger">*</span></label>
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="method" value="sms" id="smsCheck" checked>
                  <label class="form-check-label" for="smsCheck">SMS Reminder (TegaSMS)</label>
                </div>
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="method" value="app" id="appCheck" checked>
                  <label class="form-check-label" for="appCheck">In-App Notification</label>
                </div>
              </div>

              <div class="mb-3">
                <label class="form-label">Send To <span class="text-danger">*</span></label>
                <select name="recipient_group" class="form-select" required>
                  <option value="all">All Family Members</option>
                </select>
              </div>

              <div class="mb-3">
                <label class="form-label">Custom Message</label>
                <textarea name="custom_message" class="form-control" rows="4" 
                  placeholder="Habari, huu ni ukumbusho wa kikao chetu cha..."></textarea>
              </div>

              <div class="text-end">
                <button type="reset" class="btn btn-secondary">Cancel</button>
                <button type="submit" class="btn btn-primary">Send Reminder Now</button>
              </div>
            </form>

          </div>
        </div>
      </div>

      <div class="col-lg-4">
        <div class="card">
          <div class="card-body">
            <h5 class="card-title">Recent Activity</h5>
            <ul class="list-group list-group-flush">
              <li class="list-group-item">
                <small class="text-muted">Notifications are sent to all registered family members via TegaSMS.</small>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>
<!-- Google Translate Element -->
<div id="google_translate_element" style="visibility: hidden; position: absolute; z-index: -1;"></div>

<script>
function googleTranslateElementInit() {
  new google.translate.TranslateElement({
    pageLanguage: 'en',
    includedLanguages: 'en,sw',
    autoDisplay: false
  }, 'google_translate_element');

  var savedLang = localStorage.getItem("selectedLanguage");
  if (savedLang) {
    setTimeout(function () {
      setLanguage(savedLang);
    }, 800);
  }
}

function changeLanguage(lang) {
  localStorage.setItem("selectedLanguage", lang);
  setLanguage(lang);
}

function setLanguage(lang) {
  var select = document.querySelector(".goog-te-combo");
  if (select) {
    select.value = lang;
    select.dispatchEvent(new Event("change"));
  } else {
    setTimeout(function () {
      setLanguage(lang);
    }, 300);
  }
}
</script>
