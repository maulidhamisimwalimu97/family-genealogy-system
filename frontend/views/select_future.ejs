<%- include('partials/title') %>  
<%- include('partials/header') %>


<!-- ======= Main Content ======= -->
<main id="main" class="main">

  <div class="pagetitle">
    <h1>Select Future Head of Family</h1>
  </div>

  <section class="section">

    <div class="row justify-content-center">
      <div class="col-12 col-lg-10">

        <div class="card shadow-sm">
          <div class="card-body">
            <%- include('partials/notifications') %>

            <h5 class="card-title mb-3">Eligible Members (18+ Years)</h5>

            <div class="alert alert-info">
              Only adult members (18 years and above) can be selected as a <b>Future Head of Family</b>.
            </div>

            <div class="table-responsive">
              <table id="eligibleMembersTable" class="table table-striped table-hover align-middle nowrap" style="width:100%">
                <thead class="table-dark">
                  <tr>
                    <th>Select</th>
                    <th>Full Name</th>
                    <th>Gender</th>
                    <th>Age</th>
                    <th>Relationship</th>
                    <th>Branch</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (members && members.length > 0) { %>
                    <% members.forEach(member => { %>
                      <tr>
                        <td>
                          <input type="radio" name="future_head" value="<%= member.member_id %>">
                        </td>
                        <td><%= member.first_name %> <%= member.middle_name ? member.middle_name : '' %> <%= member.last_name %></td>
                        <td><%= member.gender.charAt(0).toUpperCase() + member.gender.slice(1) %></td>
                        <td>
                          <% 
                            const birthDate = new Date(member.date_of_birth);
                            const ageDifMs = Date.now() - birthDate.getTime();
                            const ageDate = new Date(ageDifMs);
                            const age = Math.abs(ageDate.getUTCFullYear() - 1970);
                          %>
                          <%= age %>
                        </td>
                        <td><%= member.relationship %></td>
                        <td><%= member.branch_type %></td>
                      </tr>
                    <% }) %>
                  <% } else { %>
                    <tr>
                      <td colspan="6" class="text-center">No eligible members found</td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>

            <div class="d-flex justify-content-end mt-3 gap-2 flex-wrap">
              <button class="btn btn-secondary" onclick="window.history.back();">
                Cancel
              </button>
              <button class="btn btn-primary" id="confirmFutureHeadBtn">
                Confirm Future Head
              </button>
            </div>

          </div>
        </div>

      </div>
    </div>

  </section>

</main>

<!-- ======= DataTables & Responsive Script ======= -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css">

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
<script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
<script src="https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap5.min.js"></script>

<!-- Alert placeholder -->
<div id="futureHeadAlert"></div>

<script>
  $(document).ready(function() {
    $('#eligibleMembersTable').DataTable({
      responsive: true,
      paging: true,
      searching: true,
      ordering: true,
      columnDefs: [
        { orderable: false, targets: 0 }
      ]
    });

    $('#confirmFutureHeadBtn').click(function() {
  const selectedId = $('input[name="future_head"]:checked').val();
  if (!selectedId) {
    alert('Please select a member to confirm as Future Head.');
    return;
  }

  $.ajax({
    url: '/confirm_future_head',
    method: 'POST',
    data: { member_id: selectedId },
    success: function(response) {
      // Update notifications partial dynamically
      const alertHtml = response.success
        ? `<div class="alert alert-success alert-dismissible fade show" role="alert">
             ${response.message}
             <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
           </div>`
        : `<div class="alert alert-danger alert-dismissible fade show" role="alert">
             ${response.message}
             <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
           </div>`;

      // Replace the partial container
      $('.card-body > .alert').first().before(alertHtml);

      // Optional: uncheck all, then check selected member
      $('input[name="future_head"]').prop('checked', false);
      $(`input[name="future_head"][value="${selectedId}"]`).prop('checked', true);
    },
    error: function() {
      const alertHtml = `<div class="alert alert-danger alert-dismissible fade show" role="alert">
        Something went wrong. Please try again.
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>`;
      $('.card-body > .alert').first().before(alertHtml);
    }
  });
});
  });
</script>

<!-- Google Translate Element -->
<div id="google_translate_element" style="visibility: hidden; position: absolute; z-index: -1;"></div>

<script>
function googleTranslateElementInit() {
  new google.translate.TranslateElement({
    pageLanguage: 'en',
    includedLanguages: 'en,sw',
    autoDisplay: false
  }, 'google_translate_element');

  var savedLang = localStorage.getItem("selectedLanguage");
  if (savedLang) {
    setTimeout(function () {
      setLanguage(savedLang);
    }, 800);
  }
}

function changeLanguage(lang) {
  localStorage.setItem("selectedLanguage", lang);
  setLanguage(lang);
}

function setLanguage(lang) {
  var select = document.querySelector(".goog-te-combo");
  if (select) {
    select.value = lang;
    select.dispatchEvent(new Event("change"));
  } else {
    setTimeout(function () {
      setLanguage(lang);
    }, 300);
  }
}
</script>
