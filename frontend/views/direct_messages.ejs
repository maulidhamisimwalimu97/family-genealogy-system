<%- include('partials/header') %>

<!-- the main content start -->
<main id="main" class="main">

<div class="pagetitle">
  <h1>Direct Messages</h1>
</div>

<section class="section">

<div class="card">
<div class="card-body p-0">

<div class="row g-0">

<!-- CONTACT LIST -->
<div class="col-lg-4 border-end">

<div class="p-3 border-bottom">
<input type="text" class="form-control" placeholder="Search member...">
</div>

<div class="contact-list">

<a href="#" class="contact-item active">
<img src="https://i.pravatar.cc/40?img=5">
<div>
<strong>Amina</strong>
<small class="d-block text-muted">See you at the meeting</small>
</div>
<span class="badge bg-primary ms-auto">2</span>
</a>

<a href="#" class="contact-item">
<img src="https://i.pravatar.cc/40?img=11">
<div>
<strong>John</strong>
<small class="d-block text-muted">Thanks for the update</small>
</div>
</a>

<a href="#" class="contact-item">
<img src="https://i.pravatar.cc/40?img=15">
<div>
<strong>Fatuma</strong>
<small class="d-block text-muted">Okay noted</small>
</div>
</a>

<a href="#" class="contact-item">
<img src="https://i.pravatar.cc/40?img=21">
<div>
<strong>Omary</strong>
<small class="d-block text-muted">Meeting link please</small>
</div>
</a>

</div>

</div>


<!-- CHAT AREA -->
<div class="col-lg-8">

<!-- Chat header -->
<div class="chat-header">

<div class="d-flex align-items-center">

<img src="https://i.pravatar.cc/45?img=5" class="rounded-circle me-2">

<div>
<strong>Amina</strong><br>
<small class="text-success">Online</small>
</div>

</div>

<i class="bi bi-three-dots fs-5"></i>

</div>


<!-- Chat messages -->
<div class="chat-body">

<div class="message received">
Hello, are you attending today's meeting?
<span class="time">10:12</span>
</div>

<div class="message sent">
Yes I will attend.
<span class="time">10:14</span>
</div>

<div class="message received">
Great 👍
<span class="time">10:15</span>
</div>

</div>


<!-- message input -->
<div class="chat-footer">

<form class="d-flex gap-2">

<button class="btn btn-light">
<i class="bi bi-emoji-smile"></i>
</button>

<button class="btn btn-light">
<i class="bi bi-paperclip"></i>
</button>

<input
type="text"
class="form-control"
placeholder="Type message..."
>

<button class="btn btn-primary">
<i class="bi bi-send"></i>
</button>

</form>

</div>

</div>

</div>
</div>
</div>

</section>

