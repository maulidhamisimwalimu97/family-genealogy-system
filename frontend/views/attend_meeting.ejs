<!-- the main content start -->
<main id="main" class="main">
<div class="pagetitle">
  <h1>Join Meeting</h1>
</div>

<section class="section d-flex justify-content-center">
  <div class="col-lg-6 col-md-8">

    <div class="card shadow-sm">
      <div class="card-body text-center p-4">

        <h4 class="card-title mb-3">Enter Meeting Link</h4>

        <form id="joinMeetingForm">

          <!-- Paste Link -->
          <div class="mb-3 text-start">
            <label class="form-label">
              Paste Meeting Link <span class="text-danger">*</span>
            </label>
            <input 
              type="text" 
              id="meetingLink" 
              class="form-control" 
              placeholder="https://familymeet.app/meeting/abc123"
              required
            >
          </div>

          <!-- OR Divider -->
          <div class="my-3">
            <hr>
            <p class="text-muted">OR</p>
          </div>

          <!-- Meeting Code -->
          <div class="mb-3 text-start">
            <label class="form-label">
              Enter Meeting Code
            </label>
            <input 
              type="text" 
              id="meetingCode" 
              class="form-control" 
              placeholder="Enter meeting code"
            >
          </div>

          <!-- Error Message -->
          <div id="errorMessage" class="alert alert-danger d-none">
            Invalid meeting link or code.
          </div>

          <!-- Join Button -->
          <div class="d-grid mt-4">
            <button type="submit" class="btn btn-success btn-lg">
              Join Meeting
            </button>
          </div>

        </form>

      </div>
    </div>

  </div>
</section>
</main>
<!-- Google Translate Element -->
<div id="google_translate_element" style="visibility: hidden; position: absolute; z-index: -1;"></div>

<script>
function googleTranslateElementInit() {
  new google.translate.TranslateElement({
    pageLanguage: 'en',
    includedLanguages: 'en,sw',
    autoDisplay: false
  }, 'google_translate_element');

  var savedLang = localStorage.getItem("selectedLanguage");
  if (savedLang) {
    setTimeout(function () {
      setLanguage(savedLang);
    }, 800);
  }
}

function changeLanguage(lang) {
  localStorage.setItem("selectedLanguage", lang);
  setLanguage(lang);
}

function setLanguage(lang) {
  var select = document.querySelector(".goog-te-combo");
  if (select) {
    select.value = lang;
    select.dispatchEvent(new Event("change"));
  } else {
    setTimeout(function () {
      setLanguage(lang);
    }, 300);
  }
}
</script>
