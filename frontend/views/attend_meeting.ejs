<body>

  <!-- ======= Header ======= -->
<%- include('partials/title') %>
<%- include('partials/header') %>

<main id="main" class="main">
  <div class="pagetitle">
    <h1>Join Meeting</h1>
  </div>

  <section class="section d-flex justify-content-center">
    <div class="col-lg-6 col-md-8">
      <div class="card shadow-sm border-0">
        <div class="card-body text-center p-5">
          <div class="mb-4">
            <i class="bi bi-camera-video text-success" style="font-size: 3rem;"></i>
            <h4 class="mt-2">Attending a Meeting</h4>
            <p class="text-muted">Enter a Google Meet link or code below</p>
          </div>

          <form id="joinMeetingForm">
            <div class="mb-3 text-start">
              <label class="form-label fw-bold">Paste Meeting Link</label>
              <input 
                type="url" 
                id="meetingLink" 
                class="form-control form-control-lg" 
                placeholder="https://meet.google.com/abc-defg-hij"
              >
            </div>

            <div class="d-flex align-items-center my-3">
              <hr class="flex-grow-1">
              <span class="mx-2 text-muted fw-bold">OR</span>
              <hr class="flex-grow-1">
            </div>

            <div class="mb-3 text-start">
              <label class="form-label fw-bold">Enter Meeting Code</label>
              <input 
                type="text" 
                id="meetingCode" 
                class="form-control form-control-lg text-center" 
                placeholder="abc-defg-hij"
                maxlength="12"
              >
            </div>

            <div id="errorMessage" class="alert alert-danger d-none">
              Please provide a valid link or meeting code.
            </div>

            <div class="d-grid mt-4">
              <button type="submit" class="btn btn-success btn-lg shadow-sm">
                <i class="bi bi-door-open-fill me-2"></i> Join Now
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>
</main>

<script>
document.getElementById('joinMeetingForm').addEventListener('submit', function(e) {
  e.preventDefault();
  
  const linkInput = document.getElementById('meetingLink').value.trim();
  const codeInput = document.getElementById('meetingCode').value.trim();
  const errorDiv = document.getElementById('errorMessage');
  
  errorDiv.classList.add('d-none');
  let finalURL = "";

  // 1. Kama ameweka Link kamili
  if (linkInput) {
    if (linkInput.startsWith('http')) {
      finalURL = linkInput;
    } else {
      errorDiv.textContent = "Please enter a valid URL (starting with http/https)";
      errorDiv.classList.remove('d-none');
      return;
    }
  } 
  // 2. Kama ameweka Code pekee (Inasaidia Google Meet Codes)
  else if (codeInput) {
    // Ondoa alama za "-" kama zipo ili kusafisha code, kisha Google itazielewa
    const cleanCode = codeInput.replace(/\s+/g, ''); 
    finalURL = `https://meet.google.com/${cleanCode}`;
  } 
  else {
    errorDiv.textContent = "Please enter either a link or a code to join.";
    errorDiv.classList.remove('d-none');
    return;
  }

  // Fungua mkutano kwenye tab mpya
  if (finalURL) {
    window.open(finalURL, '_blank');
  }
});
</script>
<!-- Google Translate Element -->
<div id="google_translate_element" style="visibility: hidden; position: absolute; z-index: -1;"></div>

<script>
function googleTranslateElementInit() {
  new google.translate.TranslateElement({
    pageLanguage: 'en',
    includedLanguages: 'en,sw',
    autoDisplay: false
  }, 'google_translate_element');

  var savedLang = localStorage.getItem("selectedLanguage");
  if (savedLang) {
    setTimeout(function () {
      setLanguage(savedLang);
    }, 800);
  }
}

function changeLanguage(lang) {
  localStorage.setItem("selectedLanguage", lang);
  setLanguage(lang);
}

function setLanguage(lang) {
  var select = document.querySelector(".goog-te-combo");
  if (select) {
    select.value = lang;
    select.dispatchEvent(new Event("change"));
  } else {
    setTimeout(function () {
      setLanguage(lang);
    }, 300);
  }
}
</script>
