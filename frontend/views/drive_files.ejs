<section class="section">

<div class="card">
<div class="card-body">

<h5 class="card-title">Family Files Storage</h5>

<!-- ACTION BAR -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">

<div class="d-flex gap-2">

<button class="btn btn-primary">
<i class="bi bi-upload"></i> Upload File
</button>

<button class="btn btn-outline-secondary">
<i class="bi bi-folder-plus"></i> New Folder
</button>

</div>

<div class="search-bar">
<input type="text" class="form-control" placeholder="Search files...">
</div>

</div>

<!-- FILE GRID -->
<div class="row">

<!-- Folder -->
<div class="col-lg-3 col-md-4 col-sm-6 mb-4">
<div class="card file-card text-center p-3">

<i class="bi bi-folder-fill text-warning fs-1"></i>

<h6 class="mt-2">Family Events</h6>

<small class="text-muted">12 files</small>

<div class="file-actions mt-2">

<i class="bi bi-eye"></i>
<i class="bi bi-download"></i>
<i class="bi bi-trash text-danger"></i>

</div>

</div>
</div>


<!-- File -->
<div class="col-lg-3 col-md-4 col-sm-6 mb-4">
<div class="card file-card text-center p-3">

<i class="bi bi-file-earmark-pdf text-danger fs-1"></i>

<h6 class="mt-2">Family Constitution</h6>

<small class="text-muted">PDF • 2MB</small>

<div class="file-actions mt-2">

<i class="bi bi-eye"></i>
<i class="bi bi-download"></i>
<i class="bi bi-trash text-danger"></i>

</div>

</div>
</div>


<!-- Image -->
<div class="col-lg-3 col-md-4 col-sm-6 mb-4">
<div class="card file-card text-center p-3">

<i class="bi bi-file-earmark-image text-success fs-1"></i>

<h6 class="mt-2">Wedding Photo</h6>

<small class="text-muted">JPG • 4MB</small>

<div class="file-actions mt-2">

<i class="bi bi-eye"></i>
<i class="bi bi-download"></i>
<i class="bi bi-trash text-danger"></i>

</div>

</div>
</div>


<!-- Document -->
<div class="col-lg-3 col-md-4 col-sm-6 mb-4">
<div class="card file-card text-center p-3">

<i class="bi bi-file-earmark-word text-primary fs-1"></i>

<h6 class="mt-2">Meeting Notes</h6>

<small class="text-muted">DOCX • 500KB</small>

<div class="file-actions mt-2">

<i class="bi bi-eye"></i>
<i class="bi bi-download"></i>
<i class="bi bi-trash text-danger"></i>

</div>

</div>
</div>

</div>

</div>
