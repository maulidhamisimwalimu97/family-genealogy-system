<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">

  <title>My Files</title>
  <meta content="Family Admin Panel for managing family genealogy records" name="description">
  <meta content="family, genealogy, admin, lineage" name="keywords">

  <!-- Favicons -->


  <!-- Google Fonts -->
  <link href="https://fonts.gstatic.com" rel="preconnect">
  <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,300i,400,400i,600,600i,700,700i|Nunito:300,300i,400,400i,600,600i,700,700i|Poppins:300,300i,400,400i,500,500i,600,600i,700,700i" rel="stylesheet">

  <!-- Vendor CSS Files -->
  <link href="/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
  <link href="/assets/vendor/boxicons/css/boxicons.min.css" rel="stylesheet">
  <link href="/assets/vendor/quill/quill.snow.css" rel="stylesheet">
  <link href="/assets/vendor/quill/quill.bubble.css" rel="stylesheet">
  <link href="/assets/vendor/remixicon/remixicon.css" rel="stylesheet">
  <link href="/assets/vendor/simple-datatables/style.css" rel="stylesheet">

  <!-- Main CSS File -->
  <link href="assets/css/style.css" rel="stylesheet">
  <link href="/assets/css/dark.css" rel="stylesheet">
</head>

<body>

  <!-- ======= Header ======= -->

<%- include('partials/title') %>
<%- include('partials/header') %>
<%- include('partials/notifications') %>


<main id="main" class="main">
  <section class="section">
    <div class="card">
      <div class="card-body">
        <h5 class="card-title">Family Files Storage</h5>

        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
          <!-- Upload & Folder -->
          <div class="d-flex gap-2">
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#uploadModal">
              <i class="bi bi-upload"></i> Upload
            </button>
            <button class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#folderModal">
              <i class="bi bi-folder-plus"></i> New Folder
            </button>
          </div>

          <input type="text" id="searchInput" class="form-control w-auto" placeholder="Search files...">
        </div>

        <!-- FILE/FOLDER GRID -->
        <div class="row" id="fileContainer">
          <% folders.forEach(folder => { %>
            <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
              <div class="card file-card text-center p-3 shadow-sm border-0 bg-light folder-card" data-folder-id="<%= folder.drive_id %>">
                <i class="bi bi-folder-fill text-warning fs-1"></i>
                <h6 class="mt-2 text-truncate">Folder: <%= folder.folder_name %></h6>
                <div class="file-actions mt-2 d-flex justify-content-center gap-2">
                  <button class="btn btn-sm btn-outline-danger delete-folder" data-id="<%= folder.drive_id %>">
                    <i class="bi bi-trash"></i>
                  </button>
                </div>
              </div>
            </div>
          <% }) %>

          <% files.forEach(file => { %>
            <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
              <div class="card file-card text-center p-3 shadow-sm border-0 bg-white">
                <% if (file.file_type.includes('image')) { %>
                  <i class="bi bi-file-earmark-image text-success fs-1"></i>
                <% } else if (file.file_type.includes('pdf')) { %>
                  <i class="bi bi-file-earmark-pdf text-danger fs-1"></i>
                <% } else { %>
                  <i class="bi bi-file-earmark-text text-primary fs-1"></i>
                <% } %>
                
                <h6 class="mt-2 text-truncate" title="<%= file.file_name %>"><%= file.file_name %></h6>
                <small class="text-muted d-block">By: <%= file.uploader %></small>

                <div class="file-actions mt-3 d-flex justify-content-center gap-2">
                  <a href="<%= file.file_path %>" download class="btn btn-sm btn-light border">
                    <i class="bi bi-download"></i>
                  </a>
                  <% if (file.uploaded_by == memberId || profile.role === 'Admin') { %>
                    <button class="btn btn-sm btn-outline-danger delete-file" data-id="<%= file.file_id %>">
                      <i class="bi bi-trash"></i>
                    </button>
                  <% } %>
                  <% if(file.file_type.includes('image')) { %>
                    <button class="btn btn-sm btn-outline-secondary preview-btn" data-path="<%= file.file_path %>">
                      <i class="bi bi-eye"></i>
                    </button>
                  <% } %>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </div>
  </section>

  <!-- UPLOAD MODAL -->
<div class="modal fade" id="uploadModal" tabindex="-1" aria-labelledby="uploadModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <form action="/upload_file" method="POST" enctype="multipart/form-data">
        
        <div class="modal-header bg-light">
          <h5 class="modal-title fw-bold" id="uploadModalLabel">Upload Files</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label fw-semibold">Select Files</label>
            
            <input type="file" name="familyFile" class="form-control mb-3" multiple required>
            
            <small class="text-muted">
              <i class="bi bi-info-circle me-1"></i>
              You can select multiple images, PDFs, or documents.
            </small>
          </div>
        </div>

        <div class="modal-footer border-0">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-success px-4">
            <i class="bi bi-cloud-arrow-up-fill me-1"></i> Upload Now
          </button>
        </div>

      </form>
    </div>
  </div>
</div>

  <!-- NEW FOLDER MODAL -->
  <div class="modal fade" id="folderModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <form action="/create_folder" method="POST">
          <div class="modal-header">
            <h5 class="modal-title">Create New Folder</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <input type="text" name="folder_name" class="form-control" placeholder="Folder Name" required>
          </div>
          <div class="modal-footer">
            <button class="btn btn-primary w-100">Create</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- IMAGE PREVIEW MODAL -->
  <div class="modal fade" id="previewModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Preview Image</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body text-center">
          <img id="previewImage" src="" alt="Preview" class="img-fluid">
        </div>
      </div>
    </div>
  </div>

</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<script>
document.addEventListener("DOMContentLoaded", function() {
  // Scroll files to top
  var container = document.getElementById('fileContainer');
  if(container) container.scrollTop = container.scrollHeight;

  // IMAGE PREVIEW
  document.querySelectorAll('.preview-btn').forEach(btn => {
    btn.addEventListener('click', e => {
      const path = btn.getAttribute('data-path');
      document.getElementById('previewImage').src = path;
      new bootstrap.Modal(document.getElementById('previewModal')).show();
    });
  });

  // DELETE FILE
  document.querySelectorAll('.delete-file').forEach(btn => {
    btn.addEventListener('click', e => {
      const fileId = btn.getAttribute('data-id');
      if(confirm("Are you sure you want to delete this file?")) {
        fetch(`/delete_file/${fileId}`, { method: 'DELETE' })
          .then(res => location.reload());
      }
    });
  });

  // DELETE FOLDER
  document.querySelectorAll('.delete-folder').forEach(btn => {
    btn.addEventListener('click', e => {
      const folderId = btn.getAttribute('data-id');
      if(confirm("Delete folder and all files inside?")) {
        fetch(`/delete_folder/${folderId}`, { method: 'DELETE' })
          .then(res => location.reload());
      }
    });
  });

  // SEARCH
  document.getElementById('searchInput').addEventListener('input', e => {
    const val = e.target.value.toLowerCase();
    document.querySelectorAll('#fileContainer .file-card').forEach(card => {
      const name = card.querySelector('h6').innerText.toLowerCase();
      card.style.display = name.includes(val) ? 'block' : 'none';
    });
  });
});
</script>

<style>
  .file-card { transition: transform 0.2s; }
  .file-card:hover { transform: translateY(-5px); cursor: pointer; background-color: #fff !important; box-shadow: 0 4px 8px rgba(0,0,0,0.1) !important; }
  .file-actions i { font-size: 1.1rem; cursor: pointer; }
</style>

<!-- Google Translate Element -->
<div id="google_translate_element" style="visibility: hidden; position: absolute; z-index: -1;"></div>

<script>
function googleTranslateElementInit() {
  new google.translate.TranslateElement({
    pageLanguage: 'en',
    includedLanguages: 'en,sw',
    autoDisplay: false
  }, 'google_translate_element');

  var savedLang = localStorage.getItem("selectedLanguage");
  if (savedLang) {
    setTimeout(function () {
      setLanguage(savedLang);
    }, 800);
  }
}

function changeLanguage(lang) {
  localStorage.setItem("selectedLanguage", lang);
  setLanguage(lang);
}

function setLanguage(lang) {
  var select = document.querySelector(".goog-te-combo");
  if (select) {
    select.value = lang;
    select.dispatchEvent(new Event("change"));
  } else {
    setTimeout(function () {
      setLanguage(lang);
    }, 300);
  }
}
</script>
