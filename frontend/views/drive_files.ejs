<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">

  <title>My Files</title>
  <meta content="Family Admin Panel for managing family genealogy records" name="description">
  <meta content="family, genealogy, admin, lineage" name="keywords">

  <!-- Favicons -->


  <!-- Google Fonts -->
  <link href="https://fonts.gstatic.com" rel="preconnect">
  <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,300i,400,400i,600,600i,700,700i|Nunito:300,300i,400,400i,600,600i,700,700i|Poppins:300,300i,400,400i,500,500i,600,600i,700,700i" rel="stylesheet">

  <!-- Vendor CSS Files -->
  <link href="/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
  <link href="/assets/vendor/boxicons/css/boxicons.min.css" rel="stylesheet">
  <link href="/assets/vendor/quill/quill.snow.css" rel="stylesheet">
  <link href="/assets/vendor/quill/quill.bubble.css" rel="stylesheet">
  <link href="/assets/vendor/remixicon/remixicon.css" rel="stylesheet">
  <link href="/assets/vendor/simple-datatables/style.css" rel="stylesheet">

  <!-- Main CSS File -->
  <link href="assets/css/style.css" rel="stylesheet">
  <link href="/assets/css/dark.css" rel="stylesheet">
</head>

<body>

<!-- ======= Header ======= -->
<%- include('partials/title') %>
<%- include('partials/header') %>
<%- include('partials/notifications') %>
<main id="main" class="main">
  <section class="section">
    <div class="card">
      <div class="card-body">
        <h5 class="card-title">Family Files Storage</h5>

        <!-- Upload & Folder -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
          <div class="d-flex gap-2">
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#uploadModal">
              <i class="bi bi-upload"></i> Upload
            </button>
            <button class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#folderModal">
              <i class="bi bi-folder-plus"></i> New Folder
            </button>
          </div>
          <input type="text" id="searchInput" class="form-control w-auto" placeholder="Search files...">
        </div>

        <!-- FILE/FOLDER GRID -->
        <div class="row" id="fileContainer">

          <!-- Folders -->
          <% if (folders && folders.length) { %>
            <% folders.forEach(folder => { %>
              <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
                <div class="card file-card text-center p-3 shadow-sm border-0 bg-light folder-card"
                     data-folder-id="<%= folder.drive_id %>">
                  <i class="bi bi-folder-fill text-warning fs-1"></i>
                  <h6 class="mt-2 text-truncate">Folder: <%= folder.folder_name %></h6>
                </div>
              </div>
            <% }) %>
          <% } %>

          <!-- Files outside folders -->
          <% if (files && files.length) { %>
            <% files.filter(f => !f.folder_id).forEach(file => { %>
              <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
                <div class="card file-card text-center p-3 shadow-sm border-0 bg-white">
                  <% if (file.file_type.includes('image')) { %>
                    <i class="bi bi-file-earmark-image text-success fs-1"></i>
                  <% } else if (file.file_type.includes('pdf')) { %>
                    <i class="bi bi-file-earmark-pdf text-danger fs-1"></i>
                  <% } else { %>
                    <i class="bi bi-file-earmark-text text-primary fs-1"></i>
                  <% } %>

                  <h6 class="mt-2 text-truncate" title="<%= file.file_name %>"><%= file.file_name %></h6>
                  <small class="text-muted d-block">By: <%= file.uploader %></small>

                  <div class="file-actions mt-3 d-flex justify-content-center gap-2">
                    <a href="<%= file.file_path %>" download class="btn btn-sm btn-light border">
                      <i class="bi bi-download"></i>
                    </a>
                    <% if (file.uploaded_by == memberId || profile.role === 'Admin') { %>
                      <button class="btn btn-sm btn-outline-danger delete-file" data-id="<%= file.file_id %>">
                        <i class="bi bi-trash"></i>
                      </button>
                    <% } %>
                    <% if(file.file_type.includes('image')) { %>
                      <button class="btn btn-sm btn-outline-secondary preview-btn" data-path="<%= file.file_path %>">
                        <i class="bi bi-eye"></i>
                      </button>
                    <% } %>
                  </div>
                </div>
              </div>
            <% }) %>
          <% } %>

        </div>
      </div>
    </div>
  </section>
</main>

<!-- MODALS -->

<!-- Upload Modal -->
<div class="modal fade" id="uploadModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content p-3">
      <h5>Upload File</h5>
      <form action="/upload_file" method="POST" enctype="multipart/form-data">
        <input type="file" name="familyFile" multiple class="form-control mb-3" required>
        <select name="folder_id" class="form-select mb-3">
          <option value="">No Folder</option>
          <% folders.forEach(f => { %>
            <option value="<%= f.drive_id %>"><%= f.folder_name %></option>
          <% }) %>
        </select>
        <button type="submit" class="btn btn-primary">Upload</button>
      </form>
    </div>
  </div>
</div>

<!-- New Folder Modal -->
<div class="modal fade" id="folderModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content p-3">
      <h5>Create Folder</h5>
      <form action="/create_folder" method="POST">
        <input type="text" name="folder_name" class="form-control mb-3" placeholder="Folder Name" required>
        <button type="submit" class="btn btn-primary">Create</button>
      </form>
    </div>
  </div>
</div>

<!-- Folder Content Modal -->
<div class="modal fade" id="folderContentModal" tabindex="-1">
  <div class="modal-dialog modal-xl modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="folderContentTitle">Folder Name</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="row" id="folderContentFiles"></div>
      </div>
    </div>
  </div>
</div>

<!-- Preview Modal -->
<div class="modal fade" id="previewModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content p-3">
      <img src="" id="previewImage" class="img-fluid" alt="Preview">
    </div>
  </div>
</div>

<!-- DELETE CONFIRM MODAL -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered modal-sm">
    <div class="modal-content text-center p-3">
      <h6 class="mb-3">Delete this file?</h6>
      <div class="d-flex justify-content-center gap-2">
        <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button class="btn btn-danger btn-sm" id="confirmDeleteBtn">Delete</button>
      </div>
    </div>
  </div>
</div>

<!-- PASS USER INFO -->
<script>
const memberId = "<%= memberId %>";
const profileRole = "<%= profile.role %>";
</script>

<script>
document.addEventListener("DOMContentLoaded", () => {

  // Folder click -> modal
  document.querySelectorAll('.folder-card').forEach(card => {
    card.addEventListener('click', () => {
      const folderId = card.dataset.folderId;
      const modalTitle = document.getElementById('folderContentTitle');
      const modalBody = document.getElementById('folderContentFiles');

      modalTitle.textContent = card.querySelector('h6').innerText;
      modalBody.innerHTML = '<p class="text-center text-muted w-100">Loading...</p>';

      fetch(`/api/folder/${folderId}`)
        .then(res => res.json())
        .then(data => {
          modalBody.innerHTML = '';
          if (!data.files.length) {
            modalBody.innerHTML = '<p class="text-center text-muted w-100">No files in this folder.</p>';
            return;
          }

          data.files.forEach(file => {
            const icon = file.file_type.includes('image') ? 'bi-file-earmark-image text-success' :
                         file.file_type.includes('pdf') ? 'bi-file-earmark-pdf text-danger' :
                         'bi-file-earmark-text text-primary';

            modalBody.insertAdjacentHTML('beforeend', `
              <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
                <div class="card text-center p-3 shadow-sm border-0 bg-white">
                  <i class="bi ${icon} fs-1"></i>
                  <h6 title="${file.file_name}">${file.file_name}</h6>
                  <small class="text-muted d-block">By: ${file.uploader}</small>
                  <div class="file-actions mt-3 d-flex justify-content-center gap-2">
                    <a href="${file.file_path}" download class="btn btn-sm btn-light border"><i class="bi bi-download"></i></a>
                    ${file.uploaded_by == memberId || profileRole === 'Admin' ? `<button class="btn btn-sm btn-outline-danger delete-file" data-id="${file.file_id}"><i class="bi bi-trash"></i></button>` : ''}
                    ${file.file_type.includes('image') ? `<button class="btn btn-sm btn-outline-secondary preview-btn" data-path="${file.file_path}"><i class="bi bi-eye"></i></button>` : ''}
                  </div>
                </div>
              </div>
            `);
          });

          // Preview inside folder
          modalBody.querySelectorAll('.preview-btn').forEach(btn =>
            btn.addEventListener('click', () => {
              document.getElementById('previewImage').src = btn.dataset.path;
              new bootstrap.Modal(document.getElementById('previewModal')).show();
            })
          );

          // Delete inside folder
          modalBody.querySelectorAll('.delete-file').forEach(btn =>
            btn.addEventListener('click', () => {
              if(confirm("Do you want to delete this file?")) {
                fetch(`/delete_file/${btn.dataset.id}`, { method: 'DELETE' })
                  .then(res => res.ok && btn.closest('.col-lg-3').remove());
              }
            })
          );

        });

      new bootstrap.Modal(document.getElementById('folderContentModal')).show();
    });
  });

  // Preview buttons outside folder
  document.querySelectorAll('.preview-btn').forEach(btn =>
    btn.addEventListener('click', () => {
      document.getElementById('previewImage').src = btn.dataset.path;
      new bootstrap.Modal(document.getElementById('previewModal')).show();
    })
  );

  // Delete buttons outside folder
  document.querySelectorAll('.delete-file').forEach(btn =>
    btn.addEventListener('click', () => {
      if(confirm("Do you want to delete this file?")) {
        fetch(`/delete_file/${btn.dataset.id}`, { method: 'DELETE' })
          .then(res => res.ok && btn.closest('.col-lg-3').remove());
      }
    })
  );

  // Search
  document.getElementById('searchInput').addEventListener('input', e => {
    const val = e.target.value.toLowerCase();
    document.querySelectorAll('#fileContainer .file-card').forEach(card => {
      const name = card.querySelector('h6').innerText.toLowerCase();
      card.style.display = name.includes(val) ? 'block' : 'none';
    });
  });

});
</script>

<style>
.file-card { transition: transform 0.2s; cursor: pointer; }
.file-card:hover { transform: translateY(-5px); background-color: #fff !important; box-shadow: 0 4px 8px rgba(0,0,0,0.1) !important; }
.file-actions i { font-size: 1.1rem; cursor: pointer; }
</style>

<!-- Google Translate Element -->
<div id="google_translate_element" style="visibility: hidden; position: absolute; z-index: -1;"></div>

<script>
function googleTranslateElementInit() {
  new google.translate.TranslateElement({
    pageLanguage: 'en',
    includedLanguages: 'en,sw',
    autoDisplay: false
  }, 'google_translate_element');

  var savedLang = localStorage.getItem("selectedLanguage");
  if (savedLang) {
    setTimeout(function () {
      setLanguage(savedLang);
    }, 800);
  }
}

function changeLanguage(lang) {
  localStorage.setItem("selectedLanguage", lang);
  setLanguage(lang);
}

function setLanguage(lang) {
  var select = document.querySelector(".goog-te-combo");
  if (select) {
    select.value = lang;
    select.dispatchEvent(new Event("change"));
  } else {
    setTimeout(function () {
      setLanguage(lang);
    }, 300);
  }
}
</script>
