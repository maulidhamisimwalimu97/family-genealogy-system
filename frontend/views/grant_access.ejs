</main>

<script>
$(document).ready(function () {
    const table = $('#grantAccessTable').DataTable({
        responsive: {
            details: {
                type: 'inline' // Ensures the "+" icon appears if columns are hidden
            }
        },
        pageLength: 5,
        retrieve: true,
        columnDefs: [
            { responsivePriority: 1, targets: 1 }, // Family Name (Very Important)
            { responsivePriority: 2, targets: 3 }, // Amount (Important)
            { responsivePriority: 3, targets: 4 }, // Action (Important)
            { responsivePriority: 4, targets: 2 }  // Admin (Can hide first)
        ]
    });

    $(document).on('click', '.select-family-btn', function() {
        const button = $(this);
        autoConfigureAccess(button.attr('data-id'), button.attr('data-name'), parseInt(button.attr('data-amount')));
        
        // Scroll to form on mobile
        if ($(window).width() < 992) {
            $('html, body').animate({
                scrollTop: $("#selected_family_id").closest('.card').offset().top - 20
            }, 500);
        }
    });
});

function autoConfigureAccess(familyId, familyName, amount) {
    document.getElementById('selected_family_id').value = familyId;
    document.getElementById('display_family_name').innerText = familyName;
    document.getElementById('saveBtn').disabled = false;

    const meetings = document.getElementById('perm_meetings');
    const drive = document.getElementById('perm_drive');
    const pkgBadge = document.getElementById('display_package');

    if (amount >= 50000) {
        pkgBadge.innerText = "Advance Package"; pkgBadge.className = "badge bg-success";
        if(meetings) meetings.checked = true; if(drive) drive.checked = true;
    } else if (amount >= 30000) {
        pkgBadge.innerText = "Standard Package"; pkgBadge.className = "badge bg-info text-dark";
        if(meetings) meetings.checked = false; if(drive) drive.checked = true;
    } else {
        pkgBadge.innerText = "Local Package"; pkgBadge.className = "badge bg-warning text-dark";
        if(meetings) meetings.checked = false; if(drive) drive.checked = false;
    }
}
</script>
