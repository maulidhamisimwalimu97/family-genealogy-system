<main id="main" class="main">
    <div class="container-fluid">

        <div class="pagetitle mb-4">
            <h1>Grant Family Access</h1>
            <p class="text-muted">Manage dashboard access for families with completed payments</p>
        </div>

        <div class="row g-4">
            <div class="col-lg-7 col-md-12">
                <div class="card shadow-sm h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Paid Families</h5>
                        <small class="text-muted d-none d-sm-block">Click 'Select' to configure</small>
                    </div>

                    <div class="card-body">
                        <div class="table-responsive" style="border: none;">
                            <table id="grantAccessTable" class="table table-hover table-striped dt-responsive nowrap" style="width:100%">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th class="all">Family</th> 
                                        <th>Admin</th>
                                        <th>Amount</th> 
                                        <th class="all">Action</th> 
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (locals.paidFamilies && paidFamilies.length > 0) { %>
                                        <% paidFamilies.forEach((family, index) => { %>
                                            <tr>
                                                <td><%= index + 1 %></td>
                                                <td><strong><%= family.family_name %></strong></td>
                                                <td><%= family.first_name %> <%= family.last_name %></td>
                                                <td><span class="text-success fw-bold"><%= Number(family.amount).toLocaleString() %></span></td>
                                                <td>
                                                    <button type="button" class="btn btn-sm btn-primary select-family-btn"
                                                            data-id="<%= family.family_id %>"
                                                            data-name="<%= family.family_name %>"
                                                            data-amount="<%= family.amount %>">
                                                        <i class="bi bi-shield-check"></i> Select
                                                    </button>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-5 col-md-12">
                <div class="card shadow-sm border-primary">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Access Control Panel</h5>
                    </div>
                    <div class="card-body">
                        <form action="/save-family-access" method="POST">
                            <input type="hidden" name="family_id" id="selected_family_id" required>
                            
                            <div class="mt-3 p-3 bg-light rounded border text-center">
                                <span class="text-muted small">Target Family:</span>
                                <h6 id="display_family_name" class="text-dark fw-bold mb-1">None Selected</h6>
                                <span id="display_package" class="badge bg-secondary">N/A</span>
                            </div>

                            <hr>
                            
                            <h6 class="text-primary fw-bold">Core Access</h6>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" name="permissions" value="family_tree" id="perm_tree" checked>
                                <label class="form-check-label">Family Tree View</label>
                            </div>

                            <h6 class="text-primary fw-bold mt-3">Premium Features</h6>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" name="permissions" value="meetings" id="perm_meetings">
                                <label class="form-check-label">Meetings Access</label>
                            </div>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" name="permissions" value="drive" id="perm_drive">
                                <label class="form-check-label">Family Drive</label>
                            </div>

                            <button type="submit" class="btn btn-success w-100 py-2 mt-4 shadow-sm" id="saveBtn" disabled>
                                <i class="bi bi-save"></i> Save & Grant Access
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
