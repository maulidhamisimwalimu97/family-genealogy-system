    <main id="main" class="main">
    <div class="container-fluid">

        <div class="pagetitle mb-4">
            <h1>Grant Family Access</h1>
            <p class="text-muted">
                Manage dashboard access for families with completed payments
            </p>
        </div>

        <div class="row g-4">

            <div class="col-lg-7 col-md-12">
                <div class="card shadow-sm">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Paid Families</h5>
                        <small class="text-muted">Click 'Select' to configure access</small>
                    </div>

                    <div class="card-body">
                        <div class="table-responsive">
                            <table id="grantAccessTable" class="table table-hover table-striped nowrap" style="width:100%">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Family</th>
                                        <th>Admin</th>
                                        <th>Amount</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                  <tbody>
                                      <% if (locals.paidFamilies && paidFamilies.length > 0) { %>
                                          <% paidFamilies.forEach((family, index) => { %>
                                              <tr>
                                                  <td><%= index + 1 %></td>
                                                  <td><strong><%= family.family_name || 'N/A' %></strong></td>
                                                  <td><%= (family.first_name || '') %> <%= (family.last_name || '') %></td>
                                                  <td><%= Number(family.amount || 0).toLocaleString() %></td>
                                                  <td>
                                                      <button type="button" 
                                                              class="btn btn-sm btn-outline-primary select-family-btn"
                                                              data-id="<%= family.family_id %>"
                                                              data-name="<%= family.family_name %>"
                                                              data-amount="<%= family.amount %>">
                                                          <i class="bi bi-shield-check"></i> Select
                                                      </button>
                                                  </td>
                                              </tr>
                                          <% }); %>
                                      <% } %>
                                  </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-5 col-md-12">
                <div class="card shadow-sm border-primary">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Access Control Panel</h5>
                    </div>

                    <div class="card-body">
                        <form action="/save-family-access" method="POST">
                            <input type="hidden" name="family_id" id="selected_family_id" required>
                            
                            <div class="mt-3 p-2 bg-light rounded border">
                                <span class="text-muted small">Target Family:</span>
                                <h6 id="display_family_name" class="text-dark mb-0">None Selected</h6>
                                <span id="display_package" class="badge bg-secondary">N/A</span>
                            </div>

                            <hr>

                            <h6 class="text-primary fw-bold">My Family & Core</h6>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" name="permissions" value="register_family" id="perm_register" checked>
                                <label class="form-check-label">Register/Add Members</label>
                            </div>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" name="permissions" value="family_lists" id="perm_lists" checked>
                                <label class="form-check-label">View Family List</label>
                            </div>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" name="permissions" value="family_tree" id="perm_tree" checked>
                                <label class="form-check-label">View Family Tree</label>
                            </div>

                            <h6 class="text-primary fw-bold mt-3">Meetings & Reminders</h6>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" name="permissions" value="meetings" id="perm_meetings">
                                <label class="form-check-label">Access Meetings (Schedule/Attend)</label>
                            </div>

                            <h6 class="text-primary fw-bold mt-3">Advanced Storage</h6>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" name="permissions" value="drive" id="perm_drive">
                                <label class="form-check-label">Family Drive (Files/Uploads)</label>
                            </div>

                            <h6 class="text-primary fw-bold mt-3">Analytics</h6>
                            <div class="form-check mb-4">
                                <input class="form-check-input" type="checkbox" name="permissions" value="reports" id="perm_reports">
                                <label class="form-check-label">Generate Reports</label>
                            </div>

                            <button type="submit" class="btn btn-success w-100 py-2" id="saveBtn" disabled>
                                <i class="bi bi-save"></i> Save & Grant Access
                            </button>
                        </form>
                    </div>
                </div>
            </div>

        </div>
    </div>
</main>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Select all buttons with our class
    const selectButtons = document.querySelectorAll('.select-family-btn');

    selectButtons.forEach(button => {
        button.addEventListener('click', function() {
            // Get data from attributes
            const familyId = this.getAttribute('data-id');
            const familyName = this.getAttribute('data-name');
            const amount = parseInt(this.getAttribute('data-amount')) || 0;

            // Run the configuration logic
            autoConfigureAccess(familyId, familyName, amount);
        });
    });
});

function autoConfigureAccess(familyId, familyName, amount) {
    // 1. Set Identifiers
    document.getElementById('selected_family_id').value = familyId;
    document.getElementById('display_family_name').innerText = familyName;
    document.getElementById('saveBtn').disabled = false;

    // 2. Elements
    const meetings = document.getElementById('perm_meetings');
    const drive = document.getElementById('perm_drive');
    const reports = document.getElementById('perm_reports');
    const pkgBadge = document.getElementById('display_package');

    // 3. Logic based on Amount
    if (amount >= 50000) {
        pkgBadge.innerText = "Advance Package";
        pkgBadge.className = "badge bg-success";
        meetings.checked = true; drive.checked = true; reports.checked = true;
    } else if (amount >= 30000) {
        pkgBadge.innerText = "Standard Package";
        pkgBadge.className = "badge bg-info text-dark";
        meetings.checked = false; drive.checked = true; reports.checked = false;
    } else {
        pkgBadge.innerText = "Local Package";
        pkgBadge.className = "badge bg-warning text-dark";
        meetings.checked = false; drive.checked = false; reports.checked = false;
    }
}
</script>
