<body>

  <!-- ======= Header ======= -->
<%- include('partials/title') %>

<%- include('partials/header') %>

<main id="main" class="main">
  <div class="pagetitle">
    <h1>Family Tree</h1>
  </div>

  <section class="section">
    <div class="card">
      <div class="card-body">

        <h5 class="card-title">Family Structure</h5>

        <div class="tree">
          <ul>

            <% if (tree && tree.length > 0) { %>

              <% tree.forEach(node => { %>

                <li>

                  <!-- ROOT -->
                  <div class="member text-center">
                    <a href="#" class="member-link" data-member-id="<%= node.member_id %>">
                      <strong><%= node.first_name %> <%= node.last_name %></strong>
                    </a>
                    <br>
                    <small><%= node.relationship || node.role %></small>
                  </div>

                  <!-- CHILDREN -->
                  <% if (node.children && node.children.length > 0) { %>
                    <ul>

                      <% node.children.forEach(child => { %>
                        <li>

                          <div class="member text-center">
                            <a href="#" class="member-link" data-member-id="<%= child.member_id %>">
                              <%= child.first_name %> <%= child.last_name %>
                            </a>
                            <br>
                            <small><%= child.relationship || '' %></small>
                          </div>

                        </li>
                      <% }) %>

                    </ul>
                  <% } %>

                </li>

              <% }) %>

            <% } else { %>

              <!-- 🔥 FIXED EMPTY STATE -->
              <li>
                <div class="member text-center">
                  <strong>No hierarchy yet</strong><br>
                  <small>System will build tree once relationships are added</small>
                </div>
              </li>

            <% } %>

          </ul>
        </div>

      </div>
    </div>
  </section>
</main>

<!-- Member Profile Modal -->
<div class="modal fade" id="memberProfileModal" tabindex="-1" aria-labelledby="memberProfileLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="memberProfileLabel">Member Profile</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="memberProfileContent">
        <!-- Profile content will be loaded dynamically -->
        <div class="text-center py-5">
          <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<script>
document.addEventListener('DOMContentLoaded', () => {
  const modalEl = document.getElementById('memberProfileModal');
  const modal = new bootstrap.Modal(modalEl);

  const contentBox = document.getElementById('memberProfileContent');

  // ================================
  // CLICK EVENT (TREE MEMBERS)
  // ================================
  document.addEventListener('click', async (e) => {
    const link = e.target.closest('.member-link');
    if (!link) return;

    e.preventDefault();

    const memberId = link.dataset.memberId;

    // Loading UI
    contentBox.innerHTML = `
      <div class="text-center py-5">
        <div class="spinner-border text-primary"></div>
        <p class="mt-2">Loading profile...</p>
      </div>
    `;

    modal.show();

    try {
      const res = await fetch(`/api/profile/${memberId}`);

      if (!res.ok) {
        throw new Error('Profile not found');
      }

      const p = await res.json();

      const fullName =
        p.fullName ||
        `${p.first_name || ''} ${p.middle_name || ''} ${p.last_name || ''}`
          .replace(/\s+/g, ' ')
          .trim();

      // ================================
      // ✅ USE AGE FROM BACKEND (IMPORTANT FIX)
      // ================================
      const age = p.age;

      const html = `
        <div class="row">

          <!-- LEFT SIDE -->
          <div class="col-md-4 text-center">
            <img src="${p.profile_image || '/assets/img/3.png'}"
                 class="rounded-circle border shadow"
                 style="width:120px;height:120px;object-fit:cover;">

            <h5 class="mt-3">${fullName || 'Unknown'}</h5>

            <span class="badge bg-primary">
              ${p.roleName || 'Member'}
            </span>

            ${p.is_future_head == 1
              ? `<div class="mt-2 text-success small">Future Head</div>`
              : ''
            }
          </div>

          <!-- RIGHT SIDE -->
          <div class="col-md-8">
            <ul class="list-group list-group-flush">

              <li class="list-group-item">
                <b>Age:</b> ${age !== null ? age + ' years' : 'N/A'}
              </li>

              <li class="list-group-item">
                <b>Gender:</b> ${p.gender || 'N/A'}
              </li>

              <li class="list-group-item">
                <b>Phone:</b> ${p.phone || 'N/A'}
              </li>

              <li class="list-group-item">
                <b>Email:</b> ${p.email || 'N/A'}
              </li>

              <li class="list-group-item">
                <b>Relationship:</b> ${p.relationship || 'Not specified'}
              </li>

              <li class="list-group-item">
                <b>Branch:</b> ${p.branch_type || 'Main'}
              </li>

              <li class="list-group-item">
                <b>Family Role:</b> ${p.roleName || 'Member'}
              </li>

            </ul>
          </div>

        </div>
      `;

      contentBox.innerHTML = html;

    } catch (err) {
      console.error(err);

      contentBox.innerHTML = `
        <div class="text-center text-danger py-4">
          <i class="bi bi-exclamation-triangle" style="font-size:30px;"></i>
          <p class="mt-2">Failed to load profile</p>
        </div>
      `;
    }
  });

});
</script>
<!-- Google Translate Element -->
<div id="google_translate_element" style="visibility: hidden; position: absolute; z-index: -1;"></div>

<script>
function googleTranslateElementInit() {
  new google.translate.TranslateElement({
    pageLanguage: 'en',
    includedLanguages: 'en,sw',
    autoDisplay: false
  }, 'google_translate_element');

  var savedLang = localStorage.getItem("selectedLanguage");
  if (savedLang) {
    setTimeout(function () {
      setLanguage(savedLang);
    }, 800);
  }
}

function changeLanguage(lang) {
  localStorage.setItem("selectedLanguage", lang);
  setLanguage(lang);
}

function setLanguage(lang) {
  var select = document.querySelector(".goog-te-combo");
  if (select) {
    select.value = lang;
    select.dispatchEvent(new Event("change"));
  } else {
    setTimeout(function () {
      setLanguage(lang);
    }, 300);
  }
}
</script>

