<body>

  <!-- ======= Header ======= -->
<%- include('partials/title') %>

<%- include('partials/header') %>

<main id="main" class="main">
  <div class="pagetitle d-flex justify-content-between align-items-center">
    <h1>Family System Report</h1>
    <button onclick="window.print()" class="btn btn-primary">
      <i class="bi bi-printer"></i> Print Report
    </button>
  </div>

  <section class="section">
    <div id="printArea">
      <div class="row">

        <div class="col-xxl-4 col-md-6">
          <div class="card info-card">
            <div class="card-body">
              <h5 class="card-title">Total Members</h5>
              <div class="d-flex align-items-center">
                <div class="card-icon rounded-circle d-flex align-items-center justify-content-center bg-success text-white">
                  <i class="bi bi-people"></i>
                </div>
                <div class="ps-3">
                  <h6><%= stats.total_members %></h6>
                  <span class="text-muted small">Registered Members</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-xxl-4 col-md-6">
          <div class="card info-card">
            <div class="card-body">
              <h5 class="card-title">Total Payments</h5>
              <div class="d-flex align-items-center">
                <div class="card-icon rounded-circle d-flex align-items-center justify-content-center bg-warning text-white">
                  <i class="bi bi-cash-stack"></i>
                </div>
                <div class="ps-3">
                  <h6><%= (stats.total_payments || 0).toLocaleString() %> TZS</h6>
                  <span class="text-muted small">Total Collection</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-xxl-4 col-md-6">
          <div class="card info-card">
            <div class="card-body">
              <h5 class="card-title">Total Meetings</h5>
              <div class="d-flex align-items-center">
                <div class="card-icon rounded-circle d-flex align-items-center justify-content-center bg-info text-white">
                  <i class="bi bi-calendar-event"></i>
                </div>
                <div class="ps-3">
                  <h6><%= stats.total_meetings || 0 %></h6>
                  <span class="text-muted small">Meetings Held</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-12 mt-4">
          <div class="card overflow-auto">
            <div class="card-body">
              <h5 class="card-title">Member Activity Report</h5>
              <table class="table table-striped table-bordered">
                <thead>
                  <tr>
                    <th>#</th>
                    <th>Full Name</th>
                    <th>Role</th>
                    <th>Files Uploaded</th>
                    <th>Total Contributed</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (tableData && tableData.length > 0) { %>
                    <% tableData.forEach((row, index) => { %>
                    <tr>
                      <td><%= index + 1 %></td>
                      <td><%= row.first_name %> <%= row.last_name %></td>
                      <td><span class="badge bg-light text-dark border"><%= row.role %></span></td>
                      <td><%= row.files_count %></td>
                      <td><%= (row.member_paid || 0).toLocaleString() %> TZS</td>
                    </tr>
                    <% }) %>
                  <% } else { %>
                    <tr>
                      <td colspan="5" class="text-center">Hakuna data inayopatikana.</td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>
</main>

<style>
/* CSS ya kusaidia Print ionekane vizuri */
@media print {
  .sidebar, .header, .btn, .pagetitle h1 {
    display: none !important;
  }
  #main {
    margin-left: 0 !important;
    padding: 0 !important;
  }
  .card {
    border: 1px solid #ddd !important;
    box-shadow: none !important;
  }
}
</style>

<!-- Google Translate Element -->
<div id="google_translate_element" style="visibility: hidden; position: absolute; z-index: -1;"></div>

<script>
function googleTranslateElementInit() {
  new google.translate.TranslateElement({
    pageLanguage: 'en',
    includedLanguages: 'en,sw',
    autoDisplay: false
  }, 'google_translate_element');

  var savedLang = localStorage.getItem("selectedLanguage");
  if (savedLang) {
    setTimeout(function () {
      setLanguage(savedLang);
    }, 800);
  }
}

function changeLanguage(lang) {
  localStorage.setItem("selectedLanguage", lang);
  setLanguage(lang);
}

function setLanguage(lang) {
  var select = document.querySelector(".goog-te-combo");
  if (select) {
    select.value = lang;
    select.dispatchEvent(new Event("change"));
  } else {
    setTimeout(function () {
      setLanguage(lang);
    }, 300);
  }
}
</script>


<!-- ===== Chart JS ===== -->

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>

const ageCtx = document.getElementById('ageReportChart').getContext('2d');

new Chart(ageCtx,{
type:'pie',

data:{
labels:['0-10 yrs','11-20 yrs','21-40 yrs','41-60 yrs','60+ yrs'],

datasets:[{
label:'Members',
data:[5,10,15,7,3],

backgroundColor:[
'rgba(75,192,192,0.7)',
'rgba(54,162,235,0.7)',
'rgba(255,206,86,0.7)',
'rgba(255,99,132,0.7)',
'rgba(153,102,255,0.7)'
]
}]
},

options:{
responsive:true,
plugins:{
legend:{position:'bottom'}
}
}

})

const paymentCtx = document.getElementById('paymentReportChart').getContext('2d');

new Chart(paymentCtx,{
type:'doughnut',

data:{
labels:['Paid','Pending','Failed'],

datasets:[{
data:[20,5,2],

backgroundColor:[
'rgba(75,192,192,0.7)',
'rgba(255,206,86,0.7)',
'rgba(255,99,132,0.7)'
]
}]
},

options:{
responsive:true,
plugins:{
legend:{position:'bottom'}
}
}

})

</script>

<!-- ===== DataTable ===== -->

<script>

