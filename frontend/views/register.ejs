<main id="main" class="main">
  <div class="pagetitle">
    <h1>Register New Family</h1>
  </div>

  <section class="section">
    <form action="/register-family" method="POST">
      <div class="row">
        
        <div class="col-lg-12">
          <div class="card shadow-sm">
            <div class="card-body">
              <h5 class="card-title">Family Cultural & Geographic Details</h5>
              
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label fw-bold">Family Name <span class="text-danger">*</span></label>
                  <input type="text" name="family_name" class="form-control" placeholder="e.g., Mwalimu Family" required>
                </div>

                <div class="col-md-6">
                  <label class="form-label fw-bold">Tribe (Kabila) <span class="text-danger">*</span></label>
                  <input type="text" name="tribe" class="form-control" placeholder="e.g., Chaga, Sukuma, Haya" required>
                </div>

                <div class="col-md-6">
                  <label class="form-label fw-bold">Region (Mkoa) <span class="text-danger">*</span></label>
                  <input type="text" name="region" class="form-control" placeholder="e.g., Dar es Salaam, Arusha" required>
                </div>

                <div class="col-md-6">
                  <label class="form-label fw-bold">Religion <span class="text-muted small">(Optional)</span></label>
                  <select name="religion" class="form-select">
                    <option value="">Choose Religion</option>
                    <option value="Christianity">Christianity</option>
                    <option value="Islam">Islam</option>
                    <option value="Other">Other</option>
                  </select>
                </div>

                <div class="col-md-12">
                  <label class="form-label fw-bold">Current Address / Street <span class="text-muted small">(Optional)</span></label>
                  <input type="text" name="address" class="form-control" placeholder="Specific location or street">
                </div>

                <hr class="my-4">
                <h6 class="fw-bold text-primary"><i class="bi bi-person-badge"></i> Family Head (Admin) Details</h6>

                <div class="col-md-4">
                  <label class="form-label fw-bold">First Name <span class="text-danger">*</span></label>
                  <input type="text" name="first_name" class="form-control" required>
                </div>

                <div class="col-md-4">
                  <label class="form-label fw-bold">Last Name <span class="text-danger">*</span></label>
                  <input type="text" name="last_name" class="form-control" required>
                </div>

                <div class="col-md-4">
                  <label class="form-label fw-bold">Gender <span class="text-danger">*</span></label>
                  <select name="gender" class="form-select" required>
                    <option value="male">Male</option>
                    <option value="female">Female</option>
                  </select>
                </div>

                <div class="col-md-6">
                  <label class="form-label fw-bold">Phone Number <span class="text-danger">*</span></label>
                  <input type="tel" name="phone" class="form-control" required>
                </div>

                <div class="col-md-6">
                  <label class="form-label fw-bold">Email Address <span class="text-muted small">(Optional)</span></label>
                  <input type="email" name="email" class="form-control" placeholder="example@mail.com">
                </div>
              </div>

              <div class="text-end mt-4">
                <button type="submit" class="btn btn-primary px-5 shadow-sm">
                  <i class="bi bi-check-circle me-1"></i> Save & Register Family
                </button>
              </div>
            </div>
          </div>
        </div>

      </div>
    </form>
  </section>
