  <link href="/assets/css/dark.css" rel="stylesheet">
</head>

<body>

  <!-- ======= Header ======= -->
<%- include('partials/title') %>


<%- include('partials/header') %>

<main id="main" class="main">
  <div class="pagetitle">
    <h1>Family Conversations</h1>
  </div>

  <section class="section">
    <div class="card shadow-sm">
      <div class="card-body">
        <ul class="list-group">
          <% familyMembers.forEach(member => { %>
            <li class="list-group-item chat-user d-flex justify-content-between"
                data-id="<%= member.member_id %>"
                data-name="<%= member.first_name %> <%= member.last_name %>">
              <div>
                <strong><%= member.first_name %> <%= member.last_name %></strong><br>
                <small><%= member.last_msg || 'Start chat...' %></small>
              </div>
              <small>
                <%= member.last_time ? new Date(member.last_time).toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'}) : '' %>
              </small>
            </li>
          <% }) %>
        </ul>
      </div>
    </div>
  </section>
</main>

<!-- MODAL -->
<div class="modal fade" id="chatModal">
  <div class="modal-dialog modal-lg modal-fullscreen-sm-down">
    <div class="modal-content d-flex flex-column" style="height:90vh">

      <div class="modal-header">
        <h5 id="chatUserName"></h5>
        <button class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div id="chatBox" class="flex-grow-1 overflow-auto p-3 d-flex flex-column"></div>

      <!-- IMAGE PREVIEW -->
      <div id="imagePreview" style="display:none; padding:10px;"></div>

      <!-- EMOJI BOX -->
      <div id="emojiBox" style="display:none; padding:10px;">
        😀 😃 😄 😁 😆 😅 😂 🤣 😊 😍 😘 😎 😢 😡 👍 🙌 🎉 ❤️
      </div>

      <!-- INPUT -->
      <form id="chatForm" class="p-2 d-flex gap-2 border-top">
        <input id="messageInput" class="form-control" placeholder="Type message...">

        <input type="file" id="imageInput" hidden>

        <button type="button" onclick="toggleEmoji()" class="btn btn-light">😊</button>
        <button type="button" onclick="imageInput.click()" class="btn btn-light">📎</button>
        <button type="submit" class="btn btn-primary">➤</button>
      </form>

    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<style>
/* ===== MODAL DARK MODE ===== */
.modal-content {
  background: #0b141a;
  color: #e9edef;
}

.modal-header {
  background: #202c33;
  border-bottom: 1px solid #2a3942;
}

#chatUserName {
  color: #e9edef;
}

/* ===== CHAT AREA ===== */
#chatBox {
  display: flex;
  flex-direction: column;
  background: #0b141a;
}

/* ===== MESSAGE COMMON ===== */
.message {
  max-width: 75%;
  padding: 10px 14px;
  margin: 6px;
  border-radius: 12px;
  word-wrap: break-word;
  font-size: 14px;
}

/* ===== SENT (WEWE - KIJANI) ===== */
.sent {
  background: #005c4b;
  color: #e9edef;
  align-self: flex-end;
  text-align: left;
  border-bottom-right-radius: 2px;
}

/* ===== RECEIVED (YEYE - NYEUPE) ===== */
.received {
  background: #202c33;
  color: #e9edef;
  align-self: flex-start;
  border-bottom-left-radius: 2px;
}

/* ===== IMAGE ===== */
.message img {
  max-width: 200px;
  border-radius: 10px;
  margin-top: 5px;
}

/* ===== INPUT AREA ===== */
#chatForm {
  background: #202c33;
}

#messageInput {
  background: #2a3942;
  border: none;
  color: #fff;
}

#messageInput::placeholder {
  color: #8696a0;
}

/* ===== BUTTONS ===== */
#chatForm .btn {
  border-radius: 8px;
}
</style>

<script>
document.addEventListener("DOMContentLoaded", () => {

  const modal = new bootstrap.Modal(document.getElementById('chatModal'));

  const chatBox = document.getElementById('chatBox');
  const chatUserName = document.getElementById('chatUserName');
  const messageInput = document.getElementById('messageInput');
  const chatForm = document.getElementById('chatForm');
  const imageInput = document.getElementById('imageInput');

  let currentUserId = null;

  // OPEN CHAT
  document.querySelectorAll('.chat-user').forEach(user=>{
    user.addEventListener('click', ()=>{
      currentUserId = user.dataset.id;
      chatUserName.innerText = user.dataset.name;
      loadMessages();
      modal.show();
    });
  });

  // LOAD
  function loadMessages(){
    fetch('/chat_messages/'+currentUserId)
    .then(res=>res.json())
    .then(data=>{
      chatBox.innerHTML='';

      if (!data.length) {
        chatBox.innerHTML = `<p class="text-center text-muted">No messages</p>`;
        return;
      }

      fetch('/mark_seen/'+currentUserId);

      data.forEach(msg=>{
        const isMe = Number(msg.isMe) === 1;

        let div=document.createElement('div');
        div.className='message '+(isMe?'sent':'received');

        let content = '';

        if (msg.image) {
          content = `<img src="/uploads/drives/${msg.image}">`;
        } else {
          content = msg.message;
        }

        div.innerHTML = content;
        chatBox.appendChild(div);
      });

      chatBox.scrollTop = chatBox.scrollHeight;
    });
  }

  // SEND TEXT
  chatForm.addEventListener('submit', e=>{
    e.preventDefault();

    const msg = messageInput.value.trim();
    if (!msg) return;

    fetch('/send_message',{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({
        receiver_id: currentUserId,
        message: msg
      })
    }).then(()=>{
      messageInput.value='';
      loadMessages();
    });
  });

  // IMAGE PREVIEW
  imageInput.addEventListener('change', ()=>{
    const file = imageInput.files[0];
    if (!file) return;

    imagePreview.style.display='block';
    imagePreview.innerHTML = `
      <img src="${URL.createObjectURL(file)}" style="max-width:120px">
      <button onclick="sendImage()" class="btn btn-success btn-sm">Send</button>
    `;
  });

  // SEND IMAGE
  window.sendImage = function(){
    const file = imageInput.files[0];
    if (!file) return;

    let fd = new FormData();
    fd.append('image', file);
    fd.append('receiver_id', currentUserId);

    fetch('/send_image',{method:'POST',body:fd})
    .then(()=>{
      imagePreview.style.display='none';
      imageInput.value='';
      loadMessages();
    });
  }

});

// EMOJI
function toggleEmoji(){
  emojiBox.style.display = emojiBox.style.display === 'none' ? 'block' : 'none';
}

emojiBox.addEventListener('click', e=>{
  messageInput.value += e.target.innerText;
});
</script>
<!-- Google Translate Element -->
<div id="google_translate_element" style="visibility: hidden; position: absolute; z-index: -1;"></div>

<script>
function googleTranslateElementInit() {
  new google.translate.TranslateElement({
    pageLanguage: 'en',
    includedLanguages: 'en,sw',
    autoDisplay: false
  }, 'google_translate_element');

  var savedLang = localStorage.getItem("selectedLanguage");
  if (savedLang) {
    setTimeout(function () {
      setLanguage(savedLang);
    }, 800);
  }
}

function changeLanguage(lang) {
  localStorage.setItem("selectedLanguage", lang);
  setLanguage(lang);
}

function setLanguage(lang) {
  var select = document.querySelector(".goog-te-combo");
  if (select) {
    select.value = lang;
    select.dispatchEvent(new Event("change"));
  } else {
    setTimeout(function () {
      setLanguage(lang);
    }, 300);
  }
}
</script>
