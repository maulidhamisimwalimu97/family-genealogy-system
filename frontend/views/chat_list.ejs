<body>

  <!-- ======= Header ======= -->
<%- include('partials/title') %>


<%- include('partials/header') %>

<main id="main" class="main">
  <div class="pagetitle">
    <h1>Family Conversations</h1>
  </div>

  <section class="section">
    <div class="card shadow-sm">
      <div class="card-body">
        <h5 class="card-title">Select a Member to Chat</h5>

        <ul class="list-group list-group-flush">
          <% if (familyMembers && familyMembers.length > 0) { %>
            <% familyMembers.forEach(member => { %>
              
              <a href="/chat_room/<%= member.member_id %>" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between py-3">
                
                <div class="d-flex align-items-center">
                  <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-3" style="width: 45px; height: 45px; font-weight: bold;">
                    <%= member.first_name.charAt(0) %>
                  </div>
                  <div>
                    <strong class="text-dark"><%= member.first_name %> <%= member.last_name %></strong><br>
                    <small class="text-muted">
                        <%= member.last_msg ? member.last_msg : 'Click to start chatting...' %>
                    </small>
                  </div>
                </div>

                <div class="text-end">
                  <small class="text-muted">
                    <%= member.last_time ? new Date(member.last_time).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) : '' %>
                  </small>
                </div>
              </a>

            <% }); %>
          <% } else { %>
            <p class="text-center p-4 text-muted">No family members found.</p>
          <% } %>
        </ul>
      </div>
    </div>
  </section>
</main>
<!-- Google Translate Element -->
<div id="google_translate_element" style="visibility: hidden; position: absolute; z-index: -1;"></div>

<script>
function googleTranslateElementInit() {
  new google.translate.TranslateElement({
    pageLanguage: 'en',
    includedLanguages: 'en,sw',
    autoDisplay: false
  }, 'google_translate_element');

  var savedLang = localStorage.getItem("selectedLanguage");
  if (savedLang) {
    setTimeout(function () {
      setLanguage(savedLang);
    }, 800);
  }
}

function changeLanguage(lang) {
  localStorage.setItem("selectedLanguage", lang);
  setLanguage(lang);
}

function setLanguage(lang) {
  var select = document.querySelector(".goog-te-combo");
  if (select) {
    select.value = lang;
    select.dispatchEvent(new Event("change"));
  } else {
    setTimeout(function () {
      setLanguage(lang);
    }, 300);
  }
}
</script>
