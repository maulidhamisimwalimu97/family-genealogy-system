<main id="main" class="main">
    <div class="pagetitle">
  <h1>Schedule Meeting</h1>
</div>

<section class="section">
  <div class="row justify-content-center">
    <div class="col-lg-10">

      <div class="card">
        <div class="card-body">

          <h5 class="card-title">Create New Meeting</h5>

          <form class="row g-3">

            <!-- Meeting Title -->
            <div class="col-12">
              <label class="form-label">
                Meeting Title <span class="text-danger">*</span>
              </label>
              <input type="text" class="form-control" placeholder="Enter meeting title" required>
            </div>

            <!-- Description -->
            <div class="col-12">
              <label class="form-label">Description</label>
              <textarea class="form-control" rows="3" placeholder="Enter meeting description"></textarea>
            </div>

            <!-- Date & Time -->
            <div class="col-md-4">
              <label class="form-label">
                Meeting Date <span class="text-danger">*</span>
              </label>
              <input type="date" class="form-control" required>
            </div>

            <div class="col-md-4">
              <label class="form-label">
                Start Time <span class="text-danger">*</span>
              </label>
              <input type="time" class="form-control" required>
            </div>

            <div class="col-md-4">
              <label class="form-label">
                End Time <span class="text-danger">*</span>
              </label>
              <input type="time" class="form-control" required>
            </div>

            <!-- Time Zone -->
            <div class="col-md-6">
              <label class="form-label">Time Zone</label>
              <select class="form-select">
                <option>Africa/Lagos</option>
                <option>Africa/Accra</option>
                <option>Europe/London</option>
                <option>America/New_York</option>
              </select>
            </div>

            <!-- Meeting Type -->
            <div class="col-md-6">
              <label class="form-label">Meeting Type</label>
              <select class="form-select" id="meetingType">
                <option value="online">Online Meeting</option>
                <option value="physical">Physical Meeting</option>
              </select>
            </div>

            <!-- Location (Hidden for Online) -->
            <div class="col-12" id="locationField" style="display:none;">
              <label class="form-label">Meeting Location</label>
              <input type="text" class="form-control" placeholder="Enter physical meeting location">
            </div>

            <!-- Participants -->
            <div class="col-12">
              <label class="form-label">
                Add Participants (Email Addresses) <span class="text-danger">*</span>
              </label>
              <input type="text" class="form-control" placeholder="example1@email.com, example2@email.com" required>
              <div class="form-text">
                Separate multiple emails using comma.
              </div>
            </div>

            <!-- Reminder -->
            <div class="col-md-6">
              <label class="form-label">Reminder</label>
              <select class="form-select">
                <option>No Reminder</option>
                <option>10 minutes before</option>
                <option>30 minutes before</option>
                <option>1 hour before</option>
                <option>1 day before</option>
              </select>
            </div>

            <!-- Auto Meeting Link -->
            <div class="col-md-6">
              <label class="form-label">Generated Meeting Link</label>
              <input type="text" class="form-control" value="https://familymeet.app/meeting/abc123" readonly>
            </div>

            <!-- Buttons -->
            <div class="col-12 text-end mt-4">
              <button type="reset" class="btn btn-secondary">Cancel</button>
              <button type="submit" class="btn btn-primary">
                Schedule Meeting
              </button>
            </div>

          </form>

        </div>
      </div>

    </div>
  </div>
</section>
