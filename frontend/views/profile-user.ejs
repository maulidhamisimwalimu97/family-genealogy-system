<body>

  <!-- ======= Header ======= -->
<%- include('partials/title') %>
<%- include('partials/header') %>

<main id="main" class="main">

  <div class="pagetitle">
    <h1>Profile</h1>
    <nav>
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/dashboard">Home</a></li>
        <li class="breadcrumb-item"><a href="/family">Family</a></li>
        <li class="breadcrumb-item active">Profile</li>
      </ol>
    </nav>
  </div>

  <section class="section profile">
    <div class="row justify-content-center">

      <div class="col-lg-6 col-md-8">
        <div class="card shadow-sm border-0 position-relative overflow-hidden">

          <!-- Profile Image -->
          <div class="text-center position-relative">
            <img 
              src="<%= profile.profile_image ? profile.profile_image + '?' + Date.now() : '/assets/img/3.png' %>" 
              alt="Profile" 
              class="rounded-circle border border-white shadow-sm position-absolute top-0 start-50 translate-middle" 
              style="width: 140px; height: 140px; object-fit: cover; z-index: 10;"
            >
          </div>

          <!-- Card Body -->
          <div class="card-body text-center mt-5 pt-5">
            <h3 class="fw-bold mb-1"><%= profile.first_name %> <%= profile.middle_name ? profile.middle_name + ' ' : '' %><%= profile.last_name %></h3>

            <p class="text-muted mb-2">
              <span class="badge bg-primary-light text-primary text-capitalize px-3 py-2 rounded-pill">
                <%= profile.role %>
              </span>
            </p>

            <p class="text-muted mb-1"><strong>Relationship:</strong> <%= profile.relationship %></p>
            <p class="text-muted mb-1"><strong>Phone:</strong> <%= profile.phone || 'N/A' %></p>
            <p class="text-muted mb-1"><strong>Email:</strong> <%= profile.email || 'N/A' %></p>
            <p class="text-muted mb-1"><strong>Gender:</strong> <%= profile.gender || 'N/A' %></p>
            <p class="text-muted mb-1"><strong>Date of Birth:</strong> <%= profile.date_of_birth ? profile.date_of_birth.toDateString() : 'N/A' %></p>
          </div>

        </div>
      </div>

    </div>
  </section>

</main>
<!-- Google Translate Element -->
<div id="google_translate_element" style="visibility: hidden; position: absolute; z-index: -1;"></div>

<script>
function googleTranslateElementInit() {
  new google.translate.TranslateElement({
    pageLanguage: 'en',
    includedLanguages: 'en,sw',
    autoDisplay: false
  }, 'google_translate_element');

  var savedLang = localStorage.getItem("selectedLanguage");
  if (savedLang) {
    setTimeout(function () {
      setLanguage(savedLang);
    }, 800);
  }
}

function changeLanguage(lang) {
  localStorage.setItem("selectedLanguage", lang);
  setLanguage(lang);
}

function setLanguage(lang) {
  var select = document.querySelector(".goog-te-combo");
  if (select) {
    select.value = lang;
    select.dispatchEvent(new Event("change"));
  } else {
    setTimeout(function () {
      setLanguage(lang);
    }, 300);
  }
}
</script>


