<main id="main" class="main">

    <div class="pagetitle">
  <h1>Register Family Member</h1>
</div>

<section class="section">
  <div class="row">
    <div class="col-lg-12">

      <div class="card">
        <div class="card-body">

          <h5 class="card-title">Add New Family Member</h5>

            <form class="row g-3">

            <!-- Required Notice -->
            <div class="col-12">
                <p class="text-muted">
                Fields marked with <span class="required">*</span> are compulsory.
                </p>
            </div>

            <!-- Personal Information -->
            <div class="col-12">
                <h6 class="fw-bold text-primary">Personal Information</h6>
                <hr>
            </div>

            <div class="col-md-4">
                <label class="form-label">
                First Name <span class="required">*</span>
                </label>
                <input type="text" class="form-control" required>
            </div>

            <div class="col-md-4">
                <label class="form-label">
                Middle Name
                </label>
                <input type="text" class="form-control">
            </div>

            <div class="col-md-4">
                <label class="form-label">
                Last Name <span class="required">*</span>
                </label>
                <input type="text" class="form-control" required>
            </div>

            <div class="col-md-4">
                <label class="form-label">
                Gender <span class="required">*</span>
                </label>
                <select class="form-select" required>
                <option value="">Select Gender</option>
                <option>Male</option>
                <option>Female</option>
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label">
                Date of Birth <span class="required">*</span>
                </label>
                <input type="date" class="form-control" required>
            </div>

            <div class="col-md-4">
                <label class="form-label">
                Marital Status
                </label>
                <select class="form-select">
                <option value="">Select Status</option>
                <option>Single</option>
                <option>Married</option>
                <option>Widowed</option>
                <option>Divorced</option>
                </select>
            </div>

            <!-- Relationship -->
            <div class="col-12 mt-4">
                <h6 class="fw-bold text-primary">Family Relationship</h6>
                <hr>
            </div>

            <div class="col-md-4">
                <label class="form-label">
                Relationship to Head of Family <span class="required">*</span>
                </label>
                <select class="form-select" required>
                <option value="">Select Relationship</option>
                <option>Spouse</option>
                <option>Child</option>
                <option>Grandchild</option>
                <option>Brother / Sister</option>
                <option>Uncle / Aunt</option>
                <option>Cousin</option>
                <option>Other Relative</option>
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label">
                Branch Type <span class="required">*</span>
                </label>
                <select class="form-select" required>
                <option value="">Select Branch Type</option>
                <option value="origin">Original Family</option>
                <option value="new_branch">New Family Branch</option>
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label">
                Role in Family <span class="required">*</span>
                </label>
                <select class="form-select" required>
                <option value="">Select Role</option>
                <option>Family Member</option>
                <option>Future Head of Family</option>
                <option>Dependent</option>
                </select>
            </div>

            <!-- Contact Information -->
            <div class="col-12 mt-4">
                <h6 class="fw-bold text-primary">Contact Information</h6>
                <hr>
            </div>

            <div class="col-md-4">
                <label class="form-label">
                Phone Number <span class="required">*</span>
                </label>
                <input type="text" class="form-control" required>
            </div>

            <div class="col-md-4">
                <label class="form-label">
                Email Address
                </label>
                <input type="email" class="form-control">
            </div>

            <div class="col-md-4">
                <label class="form-label">
                Residential Address <span class="required">*</span>
                </label>
                <input type="text" class="form-control" required>
            </div>

            <!-- System Logic Notice -->
            <div class="col-12 mt-4">
                <div class="alert alert-info">
                <strong>System Logic:</strong><br>
                • Members under 18 years are registered as Dependents (No billing).<br>
                • Members 18+ years are counted as Adult Members (Included in billing).<br>
                • If a member starts a new branch, they will become a new Head of Family.
                </div>
            </div>

            <!-- Submit -->
            <div class="col-12 text-end mt-3">
                <button type="reset" class="btn btn-secondary">Cancel</button>
                <button type="submit" class="btn btn-primary">Register Member</button>
            </div>

            </form>

        </div>
      </div>

    </div>
  </div>
