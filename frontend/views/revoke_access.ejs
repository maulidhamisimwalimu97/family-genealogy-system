    <main id="main" class="main">
    <div class="container-fluid">

        <!-- Page Title -->
        <div class="pagetitle mb-4">
        <h1>Revoke Access</h1>
        <p class="text-muted">
            Disable or remove dashboard access for families and users
        </p>
        </div>

        <div class="row g-4">

        <!-- ================= ACCESS LIST ================= -->
        <div class="col-lg-7 col-md-12">
            <div class="card shadow-sm">
            <div class="card-header">
                <h5 class="mb-0">Families with Active Access</h5>
            </div>

            <div class="card-body">
                <div class="table-responsive">
                <table id="revokeAccessTable" class="table table-striped table-hover nowrap" style="width:100%">
                    <thead>
                    <tr>
                        <th>#</th>
                        <th>Family</th>
                        <th>Family Admin</th>
                        <th>Phone</th>
                        <th>Action</th>
                    </tr>
                    </thead>
                      <tbody>
                          <% if (locals.activeFamilies && activeFamilies.length > 0) { %>
                              <% activeFamilies.forEach((family, index) => { %>
                                  <tr>
                                      <td><%= index + 1 %></td>
                                      <td><strong><%= family.family_name %></strong></td>
                                      <td><%= family.first_name %> <%= family.last_name %></td>
                                      <td><%= family.phone %></td>
                                      <td>
                                          <button class="btn btn-sm btn-outline-danger" 
                                                  onclick="prepareRevoke('<%= family.family_id %>', '<%= family.family_name %>')" 
                                                  title="Select to Revoke">
                                              <i class="bi bi-shield-x"></i> Select
                                          </button>
                                      </td>
                                  </tr>
                              <% }); %>
                          <% } else { %>
                              <tr>
                                <td colspan="5" class="text-center table-danger text-danger py-3">
                                    <i class="bi bi-exclamation-triangle-fill me-2"></i> 
                                    No families with active access found.
                                </td>
                              </tr>
                          <% } %>
                      </tbody>
                </table>
                </div>
            </div>
            </div>
        </div>

      <div class="col-lg-5 col-md-12">
            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">Revoke Access Details</h5>
                </div>

                <div class="card-body">
                    <form action="/confirm-revoke" method="POST">
                        <input type="hidden" name="family_id" id="revoke_family_id" required>

                        <div class="mt-3 p-3 bg-light rounded border border-danger-subtle">
                            <span class="text-muted small d-block">Target Family:</span>
                            <h5 id="target_family_display" class="text-danger fw-bold mb-0">None Selected</h5>
                        </div>

                        <hr>

                        <p class="text-muted small mb-3">
                            <i class="bi bi-info-circle"></i> 
                            Confirming this action will immediately strip the family of all dashboard privileges and features.
                        </p>

                        <div class="alert alert-warning py-2 small">
                            <i class="bi bi-exclamation-triangle"></i> 
                            This will clear the <strong>permissions</strong> field in the database.
                        </div>

                        <button type="submit" class="btn btn-danger w-100 py-2 shadow-sm" id="confirmRevokeBtn" disabled>
                            <i class="bi bi-shield-x"></i> Confirm & Revoke Access
                        </button>
                    </form>
                </div>
            </div>
        </div>
        </div>
