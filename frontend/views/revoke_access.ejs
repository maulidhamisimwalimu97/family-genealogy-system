 <script>
$(document).ready(function () {
    // 1. Initialize Responsive DataTable
    const table = $('#revokeAccessTable').DataTable({
        responsive: true,
        retrieve: true,
        pageLength: 10,
        lengthChange: false,
        columnDefs: [
            { responsivePriority: 1, targets: 1 }, // Family Name
            { responsivePriority: 2, targets: 4 }, // Action Button
            { responsivePriority: 3, targets: 3 }, // Phone
            { responsivePriority: 4, targets: 2 }  // Admin Name
        ],
        language: {
            search: "_INPUT_",
            searchPlaceholder: "Tafuta familia..."
        }
    });

    // 2. Event Delegation for "Select" button
    $(document).on('click', '.select-revoke-btn', function() {
        const btn = $(this);
        const familyId = btn.attr('data-id');
        const familyName = btn.attr('data-name');

        // Update the form
        $('#revoke_family_id').val(familyId);
        $('#target_family_display').text(familyName);
        $('#confirmRevokeBtn').prop('disabled', false);

        // Smooth scroll to the details card on mobile
        if ($(window).width() < 992) {
            $('html, body').animate({
                scrollTop: $("#revokeForm").closest('.card').offset().top - 20
            }, 600);
        }
    });
});
</script>



