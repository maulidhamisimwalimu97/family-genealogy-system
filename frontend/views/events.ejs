<body>

  <!-- ======= Header ======= -->
<%- include('partials/title') %>

<%- include('partials/header') %>

<main id="main" class="main">

  <div class="pagetitle d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div>
      <h1>Family Events</h1>
      <nav>
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/dashboard">Home</a></li>
          <li class="breadcrumb-item active">Events</li>
        </ol>
      </nav>
    </div>
    
    <% if (profile.role === 'family_admin') { %>
    <a href="/create_event" class="btn btn-primary shadow-sm">
      <i class="bi bi-plus-lg"></i> Post New Event
    </a>
    <% } %>
  </div><section class="section">
    <div class="row">
      
      <% const emergencyEvents = events.filter(e => e.event_type === 'msiba'); %>
      <% if (emergencyEvents.length > 0) { %>
        <div class="col-12 mb-4">
          <div class="alert alert-danger border-0 shadow-sm d-flex align-items-center" role="alert">
            <i class="bi bi-exclamation-octagon-fill fs-4 me-3"></i>
            <div>
              <strong>Emergency Alert:</strong> Kuna taarifa za msiba kwenye familia. Tafadhali pitia maelezo hapa chini.
            </div>
          </div>
        </div>
      <% } %>

      <% if (events && events.length > 0) { %>
        <% events.forEach(event => { %>
          <div class="col-lg-4 col-md-6 mb-4">
            <div class="card h-100 shadow-sm border-0 event-card">
              
              <div class="card-header border-0 bg-transparent d-flex justify-content-between align-items-center pt-3">
                <% 
                  let badgeClass = 'bg-primary';
                  let icon = 'bi-calendar-event';
                  if(event.event_type === 'msiba') { badgeClass = 'bg-danger'; icon = 'bi-heart-fill'; }
                  else if(event.event_type === 'sherehe') { badgeClass = 'bg-success'; icon = 'bi-balloon-heart-fill'; }
                  else if(event.event_type === 'mkutano') { badgeClass = 'bg-info'; icon = 'bi-people-fill'; }
                %>
                <span class="badge <%= badgeClass %> rounded-pill px-3 py-2 text-capitalize">
                  <i class="bi <%= icon %> me-1"></i> <%= event.event_type %>
                </span>
                <small class="text-muted"><%= new Date(event.event_date).toLocaleDateString('en-GB') %></small>
              </div>

              <div class="card-body">
                <h5 class="card-title pb-0 mb-2"><%= event.title %></h5>
                <p class="card-text text-muted small mb-3 text-truncate-2">
                  <%= event.description %>
                </p>

                <div class="event-info mb-3">
                  <div class="d-flex align-items-center mb-1 small text-secondary">
                    <i class="bi bi-geo-alt me-2 text-danger"></i> <%= event.location %>
                  </div>
                  <div class="d-flex align-items-center small text-secondary">
                    <i class="bi bi-clock me-2 text-primary"></i> <%= event.event_time %>
                  </div>
                </div>

                <% if (event.has_contribution) { %>
                  <hr class="my-3 opacity-25">
                  <div class="contribution-section">
                    <div class="d-flex justify-content-between mb-1 small">
                      <span>Contribution Progress</span>
                      <strong><%= Math.round((event.collected_amount || 0) / event.target_amount * 100) %>%</strong>
                    </div>
                    <div class="progress mb-2" style="height: 8px;">
                      <div class="progress-bar <%= badgeClass %>" role="progressbar" 
                           style="width: <%= (event.collected_amount / event.target_amount * 100) %>%"></div>
                    </div>
                    <div class="d-flex justify-content-between x-small fw-bold">
                      <span class="text-success"><%= (event.collected_amount || 0).toLocaleString() %> TZS</span>
                      <span class="text-muted">Target: <%= event.target_amount.toLocaleString() %> TZS</span>
                    </div>
                  </div>
                <% } %>
              </div>

              <div class="card-footer bg-transparent border-0 pb-3 text-center">
                <button class="btn btn-outline-secondary btn-sm w-100 rounded-pill" data-bs-toggle="modal" data-bs-target="#eventModal<%= event.event_id %>">
                  View Details
                </button>
              </div>

            </div>
          </div>

          <div class="modal fade" id="eventModal<%= event.event_id %>" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
              <div class="modal-content border-0">
                <div class="modal-header border-0 shadow-sm">
                  <h5 class="modal-title"><%= event.title %></h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                  <p class="text-muted"><%= event.description %></p>
                  <ul class="list-group list-group-flush rounded">
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                      <span><i class="bi bi-calendar me-2 text-primary"></i> Date</span>
                      <strong><%= new Date(event.event_date).toDateString() %></strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                      <span><i class="bi bi-geo-alt me-2 text-danger"></i> Location</span>
                      <strong><%= event.location %></strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                      <span><i class="bi bi-person me-2 text-info"></i> Posted By</span>
                      <strong><%= event.creator_name %></strong>
                    </li>
                  </ul>
                  
                  <% if (event.has_contribution) { %>
                    <div class="mt-4 text-center">
                      <p class="mb-2 text-muted small italic">Je, unataka kuchangia kwenye tukio hili?</p>
                      <a href="/event_contributions" class="btn btn-warning w-100 fw-bold">
                        <i class="bi bi-cash-stack"></i> Contribute Now
                      </a>
                    </div>
                  <% } %>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="col-12 text-center py-5">
          <i class="bi bi-calendar-x fs-1 text-muted opacity-50"></i>
          <p class="mt-3 text-muted">Hakuna matukio yaliyopangwa kwa sasa.</p>
        </div>
      <% } %>

    </div>
  </section>

</main>

<style>
  /* CSS kwa ajili ya Muonekano Bora */
  .event-card {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .event-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
  }
  .text-truncate-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;  
    overflow: hidden;
  }
  .x-small {
    font-size: 0.75rem;
  }
  .progress {
    border-radius: 10px;
    background-color: #f0f0f0;
  }
</style>

<!-- Google Translate Element -->
<div id="google_translate_element" style="visibility: hidden; position: absolute; z-index: -1;"></div>

<script>
function googleTranslateElementInit() {
  new google.translate.TranslateElement({
    pageLanguage: 'en',
    includedLanguages: 'en,sw',
    autoDisplay: false
  }, 'google_translate_element');

  var savedLang = localStorage.getItem("selectedLanguage");
  if (savedLang) {
    setTimeout(function () {
      setLanguage(savedLang);
    }, 800);
  }
}

function changeLanguage(lang) {
  localStorage.setItem("selectedLanguage", lang);
  setLanguage(lang);
}

function setLanguage(lang) {
  var select = document.querySelector(".goog-te-combo");
  if (select) {
    select.value = lang;
    select.dispatchEvent(new Event("change"));
  } else {
    setTimeout(function () {
      setLanguage(lang);
    }, 300);
  }
}
</script>


