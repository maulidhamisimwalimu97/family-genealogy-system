<body>

  <!-- ======= Header ======= -->
<%- include('partials/title') %>

<%- include('partials/header') %>

<main id="main" class="main">

<% 
  const safeEvents = Array.isArray(events) ? events : [];
  const emergencyEvents = safeEvents.filter(e => e && e.event_type === 'msiba');
%>

<div class="pagetitle d-flex justify-content-between align-items-center flex-wrap gap-3">
  <div>
    <h1>Family Events</h1>
    <nav>
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/dashboard">Home</a></li>
        <li class="breadcrumb-item active">Events</li>
      </ol>
    </nav>
  </div>

  <% if (profile && profile.role === 'family_admin') { %>
    <a href="/create_event" class="btn btn-primary shadow-sm">
      <i class="bi bi-plus-lg"></i> Post New Event
    </a>
  <% } %>
</div>

<section class="section">
  <div class="row">

    <% if (emergencyEvents.length > 0) { %>
      <div class="col-12 mb-4">
        <div class="alert alert-danger border-0 shadow-sm d-flex align-items-center">
          <i class="bi bi-exclamation-octagon-fill fs-4 me-3"></i>
          <div>
            <strong>Emergency Alert:</strong> Kuna taarifa za msiba kwenye familia.
          </div>
        </div>
      </div>
    <% } %>

    <% if (safeEvents.length > 0) { 
         for (let i = 0; i < safeEvents.length; i++) { 
           const event = safeEvents[i];
           if (!event) continue;

           const eventId = event.event_id || event.id || Math.random().toString(36).substr(2,5);
           const type = event.event_type || '';
           let badgeClass = 'bg-primary', icon = 'bi-calendar-event';

           if(type === 'msiba') { badgeClass='bg-danger'; icon='bi-heart-fill'; }
           else if(type === 'sherehe') { badgeClass='bg-success'; icon='bi-balloon-heart-fill'; }
           else if(type === 'mkutano') { badgeClass='bg-info'; icon='bi-people-fill'; }

           const target = Number(event.target_amount) || 0;
           const collected = Number(event.collected_amount) || 0;
           const percent = target > 0 ? Math.round((collected / target) * 100) : 0;
    %>

      <div class="col-lg-4 col-md-6 mb-4">
        <div class="card h-100 shadow-sm border-0 event-card">

          <div class="card-header border-0 bg-transparent d-flex justify-content-between align-items-center pt-3">
            <span class="badge <%= badgeClass %> rounded-pill px-3 py-2 text-capitalize">
              <i class="bi <%= icon %> me-1"></i> <%= type %>
            </span>
            <small class="text-muted">
              <%= event.event_date ? new Date(event.event_date).toLocaleDateString('en-GB') : '' %>
            </small>
          </div>

          <div class="card-body">
            <h5 class="card-title mb-2 text-primary text-truncate">
              <%= event.title || '' %>
            </h5>

            <p class="card-text text-muted small mb-3">
              <%= event.description || '' %>
            </p>

            <div class="event-info mb-3">
              <div class="small text-secondary mb-1">
                <i class="bi bi-geo-alt me-2 text-danger"></i> <%= event.location || '' %>
              </div>
              <div class="small text-secondary">
                <i class="bi bi-clock me-2 text-primary"></i> <%= event.event_time || '' %>
              </div>
            </div>

            <% if (event.has_contribution) { %>
              <hr>
              <div>
                <div class="d-flex justify-content-between small mb-1">
                  <span>Progress</span>
                  <strong><%= percent %>%</strong>
                </div>
                    <div class="progress mb-2" style="height:8px;">
                </div>
                <div class="d-flex justify-content-between small">
                  <span class="text-success"><%= collected.toLocaleString() %></span>
                  <span class="text-muted">/ <%= target.toLocaleString() %></span>
                </div>
              </div>
            <% } %>
          </div>

          <div class="card-footer bg-transparent border-0 pt-0 pb-3">
            <button class="btn btn-outline-primary btn-sm w-100"
                    data-bs-toggle="modal"
                    data-bs-target="#eventModal<%= eventId %>">
              View Details
            </button>
          </div>

        </div>
      </div>

      <!-- MODAL -->
      <div class="modal fade" id="eventModal<%= eventId %>" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content border-0 shadow">

            <div class="modal-header bg-light">
              <h5 class="modal-title fw-bold"><%= event.title || '' %></h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
              <p class="text-muted mb-4"><%= event.description || '' %></p>

              <ul class="list-group list-group-flush rounded border">
                <li class="list-group-item d-flex justify-content-between">
                  <span>Date</span>
                  <strong><%= event.event_date ? new Date(event.event_date).toDateString() : '' %></strong>
                </li>

                <li class="list-group-item d-flex justify-content-between">
                  <span>Location</span>
                  <strong><%= event.location || '' %></strong>
                </li>

                <li class="list-group-item d-flex justify-content-between">
                  <span>Posted By</span>
                  <strong class="text-primary"><%= event.creator_name || 'Admin' %></strong>
                </li>
              </ul>

              <% if (event.has_contribution) { %>
                <div class="mt-4">
                  <a href="/event_contributions" class="btn btn-warning w-100 py-2 fw-bold">
                    <i class="bi bi-wallet2 me-2"></i> Contribute Now
                  </a>
                </div>
              <% } %>

            </div>

          </div>
        </div>
      </div>

    <% } } else { %>
      <div class="col-12 text-center py-5">
        <i class="bi bi-calendar-x fs-1 text-muted"></i>
        <p class="mt-3 text-muted">Hakuna matukio yaliyopo kwa sasa.</p>
      </div>
    <% } %>

  </div>
</section>
</main>
<style>
  /* CSS kwa ajili ya Muonekano Bora */
  .event-card {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .event-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
  }
  
  .x-small {
    font-size: 0.75rem;
  }
  .progress {
    border-radius: 10px;
    background-color: #f0f0f0;
  }
</style>

<!-- Google Translate Element -->
<div id="google_translate_element" style="visibility: hidden; position: absolute; z-index: -1;"></div>

<script>
function googleTranslateElementInit() {
  new google.translate.TranslateElement({
    pageLanguage: 'en',
    includedLanguages: 'en,sw',
    autoDisplay: false
  }, 'google_translate_element');

  var savedLang = localStorage.getItem("selectedLanguage");
  if (savedLang) {
    setTimeout(function () {
      setLanguage(savedLang);
    }, 800);
  }
}

function changeLanguage(lang) {
  localStorage.setItem("selectedLanguage", lang);
  setLanguage(lang);
}

function setLanguage(lang) {
  var select = document.querySelector(".goog-te-combo");
  if (select) {
    select.value = lang;
    select.dispatchEvent(new Event("change"));
  } else {
    setTimeout(function () {
      setLanguage(lang);
    }, 300);
  }
}
</script>


