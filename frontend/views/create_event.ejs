<%- include('partials/title') %>

<%- include('partials/header') %>

<main id="main" class="main">

  <div class="pagetitle">
    <h1>Post New Event</h1>
    <nav>
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/dashboard">Home</a></li>
        <li class="breadcrumb-item"><a href="/events">Events</a></li>
        <li class="breadcrumb-item active">Create</li>
      </ol>
    </nav>
  </div><section class="section">
    <div class="row justify-content-center">
      <div class="col-lg-8">

        <%- include('partials/notifications') %>

        <div class="card shadow-sm border-0">
          <div class="card-body p-4">
            <h5 class="card-title mb-4"><i class="bi bi-pencil-square me-2"></i> Event Information</h5>

            <form action="/save_event" method="POST" class="row g-3">
              
              <div class="col-md-12">
                <label class="form-label fw-bold">Event Title</label>
                <input type="text" name="title" class="form-control" placeholder="Mfano: Arusi ya Juma au Msiba wa Babu" required>
              </div>

              <div class="col-md-6">
                <label class="form-label fw-bold">Event Type</label>
                <select name="event_type" id="eventType" class="form-select" required onchange="updateEventTheme()">
                  <option value="mkutano">Mkutano (Meeting)</option>
                  <option value="sherehe">Sherehe (Celebration)</option>
                  <option value="msiba">Msiba (Funeral/Emergency)</option>
                  <option value="nyingine">Nyingine (Other)</option>
                </select>
              </div>

              <div class="col-md-6">
                <label class="form-label fw-bold">Event Date</label>
                <input type="date" name="event_date" class="form-control" required>
              </div>

              <div class="col-md-6">
                <label class="form-label fw-bold">Time</label>
                <input type="time" name="event_time" class="form-control">
              </div>

              <div class="col-md-6">
                <label class="form-label fw-bold">Location / Venue</label>
                <input type="text" name="location" class="form-control" placeholder="Wapi yatafanyika?" required>
              </div>

              <div class="col-12">
                <label class="form-label fw-bold">Description / Details</label>
                <textarea name="description" class="form-control" rows="4" placeholder="Maelezo zaidi kuhusu tukio hili..." required></textarea>
              </div>

              <div class="col-12 mt-4">
                <div class="form-check form-switch p-3 bg-light rounded border">
                  <input class="form-check-input ms-0 me-3" type="checkbox" name="has_contribution" id="hasContribution" value="1" onchange="toggleContributionField()">
                  <label class="form-check-label fw-bold" for="hasContribution">
                    Je, tukio hili linahitaji michango ya pesa?
                  </label>
                </div>
              </div>

              <div class="col-md-12 mt-3" id="contributionField" style="display: none;">
                <label class="form-label fw-bold text-success">Target Amount (TZS)</label>
                <div class="input-group">
                  <span class="input-group-text bg-success text-white">TZS</span>
                  <input type="number" name="target_amount" class="form-control" placeholder="Lengo la kiasi kinachohitajika">
                </div>
                <small class="text-muted italic">Mfumo utaonyesha progress bar kulingana na kiasi hiki.</small>
              </div>

              <div class="col-12 text-end mt-5">
                <hr>
                <button type="reset" class="btn btn-light px-4 me-2 border">Clear</button>
                <button type="submit" id="submitBtn" class="btn btn-primary px-5 shadow">
                  <i class="bi bi-send-fill me-1"></i> Post Event
                </button>
              </div>

            </form>
            </div>
        </div>
      </div>
    </div>
  </section>
</main>

<script>
  // Function ya kuonyesha/kuficha field ya mchango
  function toggleContributionField() {
    const isChecked = document.getElementById('hasContribution').checked;
    const field = document.getElementById('contributionField');
    field.style.display = isChecked ? 'block' : 'none';
  }

  // Function ya kubadilisha rangi kulingana na aina ya tukio
  function updateEventTheme() {
    const type = document.getElementById('eventType').value;
    const submitBtn = document.getElementById('submitBtn');
    
    if (type === 'msiba') {
      submitBtn.className = 'btn btn-danger px-5 shadow';
      alert("Tahadhari: Ukichagua MSIBA, mfumo utatuma SMS ya dharura kwa familia nzima baada ya kusave.");
    } else if (type === 'sherehe') {
      submitBtn.className = 'btn btn-success px-5 shadow';
    } else {
      submitBtn.className = 'btn btn-primary px-5 shadow';
    }
  }
</script>

<style>
  .form-control:focus, .form-select:focus {
    border-color: #4154f1;
    box-shadow: 0 0 0 0.2rem rgba(65, 84, 241, 0.1);
  }
  .form-label {
