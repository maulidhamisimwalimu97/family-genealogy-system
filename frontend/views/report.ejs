      </div>

    </div>

    <div class="row">
      <div class="col-lg-6">
        <div class="card shadow-sm mb-4">
          <div class="card-header bg-white">
            <h5 class="mb-0 fw-bold"><i class="bi bi-people me-2"></i>Registration Period</h5>
          </div>
          <div class="card-body pt-3">
