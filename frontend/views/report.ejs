                <tr><td>This Month</td><td class="text-end fw-bold"><%= stats.month %></td></tr>
                <tr><td>This Year</td><td class="text-end fw-bold"><%= stats.year %></td></tr>
                <tr><td>All Time</td><td class="text-end fw-bold"><%= stats.total %></td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <div class="col-lg-6">
        <div class="card shadow-sm mb-4">
