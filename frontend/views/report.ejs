            <h5 class="mb-0 fw-bold"><i class="bi bi-cash-stack me-2"></i>Payments Summary</h5>
          </div>
          <div class="card-body pt-3">
            <table class="table table-hover">
              <thead class="table-light">
                <tr>
                  <th>Status</th>
                  <th class="text-end">Families</th>
                </tr>
              </thead>
              <tbody>
