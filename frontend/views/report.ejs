                  <td class="text-success"><i class="bi bi-check-circle-fill me-2"></i>Paid</td>
                  <td class="text-end fw-bold text-success"><%= stats.paid %></td>
                </tr>
                <tr>
                  <td class="text-danger"><i class="bi bi-x-circle-fill me-2"></i>Unpaid</td>
