                </tr>
              </tbody>
              <tfoot class="table-light">
                <tr class="fw-bold">
                  <td>Total</td>
                  <td class="text-end"><%= stats.total %></td>
                </tr>
              </tfoot>
            </table>
          </div>
        </div>
      </div>
    </div>

    <div class="card shadow-sm mb-4">
