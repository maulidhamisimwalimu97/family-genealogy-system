            </tr>
            <tr>
              <td>Revoked/Inactive Access</td>
              <td class="text-center text-danger"><%= stats.revoked %></td>
            </tr>
            <tr>
              <td>System Administrators</td>
              <td class="text-center"><%= stats.users %></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="text-center mt-4 pb-4">
      <p class="small text-muted">
        Report generated on <strong><%= stats.dateGenerated %></strong><br>
        <span class="fw-bold">Family Genealogy Management System</span>
      </p>
    </div>

