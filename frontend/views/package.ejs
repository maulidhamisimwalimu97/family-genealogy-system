<html lang="en">

<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">

  <title>Package</title>
  <meta content="Family Admin Panel for managing family genealogy records" name="description">
  <meta content="family, genealogy, admin, lineage" name="keywords">

  <!-- Favicons -->


  <!-- Google Fonts -->
  <link href="https://fonts.gstatic.com" rel="preconnect">
  <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,300i,400,400i,600,600i,700,700i|Nunito:300,300i,400,400i,600,600i,700,700i|Poppins:300,300i,400,400i,500,500i,600,600i,700,700i" rel="stylesheet">

  <!-- Vendor CSS Files -->
  <link href="/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
  <link href="/assets/vendor/boxicons/css/boxicons.min.css" rel="stylesheet">
  <link href="/assets/vendor/quill/quill.snow.css" rel="stylesheet">
  <link href="/assets/vendor/quill/quill.bubble.css" rel="stylesheet">
  <link href="/assets/vendor/remixicon/remixicon.css" rel="stylesheet">
  <link href="/assets/vendor/simple-datatables/style.css" rel="stylesheet">

  <!-- Main CSS File -->
  <link href="assets/css/style.css" rel="stylesheet">
  <link href="/assets/css/dark.css" rel="stylesheet">
</head>

<body>

  <!-- ======= Header ======= -->
<%- include('partials/title') %>
  
<%- include('partials/header') %>

<main id="main" class="main">
  <div class="pagetitle">
    <h1>System Subscription</h1>
  </div>

  <section class="section">
    <%- include('partials/notifications') %>

    <div class="row">
      <div class="col-12">
        <% if (family.package_status === 'trial' && !isTrialExpired) { %>
          <div class="alert alert-info border-0 shadow-sm">
            <i class="bi bi-clock-history me-2"></i> Unatumia **Trial Package**. Itaisha tarehe: <strong><%= new Date(family.expiry_date).toLocaleString() %></strong>
          </div>
        <% } else if (isTrialExpired || family.package_status === 'expired') { %>
          <div class="alert alert-danger border-0 shadow-sm">
            <i class="bi bi-exclamation-triangle me-2"></i> Muda wako wa majaribio umeisha! Tafadhali lipia kifurushi kuendelea.
          </div>
        <% } else if (family.package_status === 'pending') { %>
          <div class="alert alert-warning border-0 shadow-sm">
            <i class="bi bi-hourglass-split me-2"></i> Malipo yako yanahakikiwa na Admin. Akaunti itakuwa 'Active' hivi punde.
          </div>
        <% } %>
      </div>
    </div>

    <div class="row mt-4">
      <% packages.forEach(pkg => { %>
        <div class="col-lg-4">
          <div class="card pricing-card shadow-sm border-0 <%= family.package_id == pkg.id ? 'border-primary border-2' : '' %>">
            <div class="card-body p-4 text-center">
              <h5 class="card-title text-uppercase fw-bold"><%= pkg.name %></h5>
              <div class="display-5 my-3 text-primary"><%= (pkg.price).toLocaleString() %> <span class="fs-6 text-muted">TZS</span></div>
              <p class="text-muted small">Muda: <%= pkg.duration_days %> Siku</p>
              
              <ul class="list-unstyled my-4 text-start">
                <% const features = pkg.features.split(','); %>
                <% features.forEach(f => { %>
                  <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i> <%= f %></li>
                <% }) %>
              </ul>

              <button class="btn btn-primary w-100 rounded-pill" data-bs-toggle="modal" data-bs-target="#payModal<%= pkg.id %>">
                <%= family.package_id == pkg.id ? 'Renew Package' : 'Select Package' %>
              </button>
            </div>
          </div>
        </div>

        <div class="modal fade" id="payModal<%= pkg.id %>" tabindex="-1">
          <div class="modal-dialog">
            <form action="/subscribe" method="POST" class="modal-content">
              <div class="modal-header border-0">
                <h5 class="modal-title">Lipia Kifurushi: <%= pkg.name %></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
              </div>
              <div class="modal-body text-center">
                <p class="mb-4">Tafadhali tuma kiasi cha **<%= pkg.price.toLocaleString() %> TZS** kwenda:</p>
                <div class="bg-light p-3 rounded mb-4">
                  <strong>M-PESA: 07XX XXX XXX (JINA)</strong><br>
                  <strong>TIGO-PESA: 06XX XXX XXX (JINA)</strong>
                </div>
                
                <input type="hidden" name="package_id" value="<%= pkg.id %>">
                <div class="text-start">
                  <label class="form-label fw-bold">Namba ya Muamala (Ref Number)</label>
                  <input type="text" name="ref_number" class="form-control" placeholder="Mfano: RYH67GTR" required>
                </div>
              </div>
              <div class="modal-footer border-0">
                <button type="submit" class="btn btn-success w-100">Tuma Maombi ya Activation</button>
              </div>
            </form>
          </div>
        </div>
      <% }) %>
    </div>
  </section>
</main>

<style>
  .pricing-card { transition: 0.3s; }
  .pricing-card:hover { transform: translateY(-10px); }
</style>

<!-- Google Translate Element -->
<div id="google_translate_element" style="visibility: hidden; position: absolute; z-index: -1;"></div>

<script>
function googleTranslateElementInit() {
  new google.translate.TranslateElement({
    pageLanguage: 'en',
    includedLanguages: 'en,sw',
    autoDisplay: false
  }, 'google_translate_element');

  var savedLang = localStorage.getItem("selectedLanguage");
  if (savedLang) {
    setTimeout(function () {
      setLanguage(savedLang);
    }, 800);
  }
}

function changeLanguage(lang) {
  localStorage.setItem("selectedLanguage", lang);
  setLanguage(lang);
}

function setLanguage(lang) {
  var select = document.querySelector(".goog-te-combo");
  if (select) {
    select.value = lang;
    select.dispatchEvent(new Event("change"));
  } else {
    setTimeout(function () {
      setLanguage(lang);
    }, 300);
  }
}
</script>
  <!-- ======= Footer ======= -->
