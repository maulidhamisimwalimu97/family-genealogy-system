  <!-- Main CSS File -->
  <link href="assets/css/style.css" rel="stylesheet">
  <link href="/assets/css/dark.css" rel="stylesheet">
</head>

<body>

  <!-- ======= Header ======= -->
<%- include('partials/title') %>
  
<%- include('partials/header') %>

<main id="main" class="main">
  <div class="pagetitle">
    <h1>System Subscription</h1>
  </div>

  <section class="section">
    <%- include('partials/notifications') %>

    <div class="row">
      <div class="col-12">
        <% if (family.package_status === 'active') { %>
          <div class="alert alert-success border-0 shadow-sm">
            <div class="d-flex align-items-center">
              <i class="bi bi-check-circle-fill fs-4 me-3"></i>
              <div>
                <h6 class="mb-0 fw-bold">Kifurushi Chako Kiko Active!</h6>
                <span>Unatumia kifurushi cha: <strong><%= family.current_package_name %></strong>. Itaisha tarehe: <strong><%= new Date(family.expiry_date).toLocaleDateString('en-GB', { 
                  day: '2-digit', 
                  month: 'long', 
                  year: 'numeric' 
                }) %></strong></span>
              </div>
            </div>
          </div>

        <% } else if (family.package_status === 'trial' && !isTrialExpired) { %>
          <div class="alert alert-info border-0 shadow-sm">
            <i class="bi bi-clock-history me-2"></i> Unatumia **Trial Package**. Itaisha tarehe: <strong><%= new Date(family.expiry_date).toLocaleString() %></strong>
          </div>

        <% } else if (isTrialExpired || family.package_status === 'expired') { %>
          <div class="alert alert-danger border-0 shadow-sm">
            <i class="bi bi-exclamation-triangle me-2"></i> Muda wako wa majaribio au kifurushi umeisha! Tafadhali lipia kuendelea.
          </div>

        <% } else if (family.package_status === 'pending') { %>
          <div class="alert alert-warning border-0 shadow-sm">
            <i class="bi bi-hourglass-split me-2"></i> Malipo yako yanahakikiwa na Admin. Akaunti itakuwa 'Active' hivi punde.
          </div>
        <% } %>
      </div>
    </div>

    <div class="row mt-4">
      <% packages.forEach(pkg => { %>
        <div class="col-lg-4">
          <div class="card pricing-card shadow-sm border-0 <%= family.package_id == pkg.id && family.package_status === 'active' ? 'border-success border-3' : '' %>">
            <div class="card-body p-4 text-center">
              
              <% if (family.package_id == pkg.id && family.package_status === 'active') { %>
                 <span class="badge bg-success mb-2">Current Active Plan</span>
              <% } %>

              <h5 class="card-title text-uppercase fw-bold"><%= pkg.name %></h5>
              <div class="display-5 my-3 text-primary"><%= (Number(pkg.price)).toLocaleString() %> <span class="fs-6 text-muted">TZS</span></div>
              <p class="text-muted small">Muda: <%= pkg.duration_days %> Siku</p>
              
          <ul class="list-unstyled my-4 text-start">
            <% if (pkg.features && pkg.features.trim() !== '') { %>
              <% const features = pkg.features.split(','); %>
              <% features.forEach(f => { %>
                <% if (f.trim() !== '') { %> <li class="mb-2">
                    <i class="bi bi-check-circle-fill text-success me-2"></i> 
                    <%= f.trim() %>
                  </li>
                <% } %>
              <% }) %>
            <% } else { %>
              <li class="mb-2 text-muted small fst-italic">
                <i class="bi bi-info-circle me-2"></i> Maelezo ya vipengele hayajapatikana
              </li>
            <% } %>
          </ul>
              <button class="btn <%= family.package_id == pkg.id ? 'btn-outline-success' : 'btn-primary' %> w-100 rounded-pill" data-bs-toggle="modal" data-bs-target="#payModal<%= pkg.id %>">
                <%= family.package_id == pkg.id ? 'Renew / Extend' : 'Select Package' %>
              </button>
            </div>
          </div>
        </div>
        <% }) %>
    </div>
  </section>
</main>

<style>
  .pricing-card { transition: 0.3s; }
  .pricing-card:hover { transform: translateY(-10px); }
</style>

<!-- Google Translate Element -->
<div id="google_translate_element" style="visibility: hidden; position: absolute; z-index: -1;"></div>

<script>
function googleTranslateElementInit() {
  new google.translate.TranslateElement({
    pageLanguage: 'en',
    includedLanguages: 'en,sw',
    autoDisplay: false
  }, 'google_translate_element');

  var savedLang = localStorage.getItem("selectedLanguage");
  if (savedLang) {
    setTimeout(function () {
      setLanguage(savedLang);
    }, 800);
  }
}

function changeLanguage(lang) {
  localStorage.setItem("selectedLanguage", lang);
  setLanguage(lang);
}

function setLanguage(lang) {
  var select = document.querySelector(".goog-te-combo");
  if (select) {
    select.value = lang;
    select.dispatchEvent(new Event("change"));
  } else {
    setTimeout(function () {
      setLanguage(lang);
    }, 300);
  }
}
</script>
