    <!-- Google Translate Element -->
<div id="google_translate_element" style="visibility: hidden; position: absolute; z-index: -1;"></div>

<script>
function googleTranslateElementInit() {
  new google.translate.TranslateElement({
    pageLanguage: 'en',
    includedLanguages: 'en,sw',
    autoDisplay: false
  }, 'google_translate_element');

  var savedLang = localStorage.getItem("selectedLanguage");
  if (savedLang) {
    setTimeout(function () {
      setLanguage(savedLang);
    }, 800);
  }
}

function changeLanguage(lang) {
  localStorage.setItem("selectedLanguage", lang);
  setLanguage(lang);
}

function setLanguage(lang) {
  var select = document.querySelector(".goog-te-combo");
  if (select) {
    select.value = lang;
    select.dispatchEvent(new Event("change"));
  } else {
    setTimeout(function () {
      setLanguage(lang);
    }, 300);
  }
}
</script>



<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.datatables.net/responsive/2.4.1/js/dataTables.responsive.min.js"></script>

<script>
$(document).ready(function() {
    $('#unpaidFamiliesTable').DataTable({
        responsive: true,
        columnDefs: [
            { responsivePriority: 1, targets: 1 }, // Family Name
            { responsivePriority: 2, targets: 7 }, // Action Button
            { responsivePriority: 3, targets: 3 }  // Phone
        ],
        language: {
            search: "_INPUT_",
            searchPlaceholder: "Search families...",
        }
    });
});

function sendReminder(phone, familyName) {
    if (!phone || phone === 'N/A') {
        Swal.fire('Hitilafu', 'Namba ya simu haipatikani!', 'error');
        return;
    }

    Swal.fire({
        title: 'Tuma Ukumbusho?',
        text: `Je, unataka kutuma SMS ya ukumbusho wa malipo kwa familia ya ${familyName}?`,
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#ffc107',
        cancelButtonColor: '#3085d6',
        confirmButtonText: 'Ndiyo, Tuma',
        cancelButtonText: 'Hapana'
    }).then((result) => {
        if (result.isConfirmed) {
            Swal.fire({
                title: 'Inatuma SMS...',
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            fetch('/send-payment-reminder', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ phone, familyName })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    Swal.fire('Imetumwa!', `Ujumbe umetumwa kwa familia ya ${familyName}.`, 'success');
                } else {
                    Swal.fire('Imeshindwa', 'SMS haijatumwa. Angalia salio la Beem au intaneti.', 'error');
                }
            })
            .catch(error => {
                Swal.fire('Error', 'Hitilafu ya kiufundi imetokea.', 'error');
            });
        }
    });
}
</script>


