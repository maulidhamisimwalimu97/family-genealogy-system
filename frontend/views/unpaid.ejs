        <div class="pagetitle mb-4">
        <h1>Unpaid Families</h1>
        <p class="text-muted">Families without completed payments</p>
        </div>

        <!-- Unpaid Families Card -->
        <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Unpaid Family List</h5>
            <span class="badge bg-danger">Payment Pending</span>
        </div>

        <div class="card-body">
            <div class="table-responsive">
            <table id="unpaidFamiliesTable" class="table table-striped table-hover nowrap" style="width:100%">
                <thead>
                <tr>
                    <th>#</th>
                    <th>Family</th>
                    <th>Family Admin</th>
                    <th>Phone</th>
                    <th>Expected Amount (TZS)</th>
                    <th>Last Payment</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
                </thead>

             <tbody>
                <% if (locals.unpaidFamilies && unpaidFamilies.length > 0) { %>
                  <% unpaidFamilies.forEach((family, index) => { %>
                    <tr>
                      <td><%= index + 1 %></td>
                      <td><strong><%= family.family_name %></strong></td>
                      <td><%= family.first_name %> <%= family.last_name %></td>
                      <td><%= family.phone %></td>
                      <td>
                          <%= family.expected_amount ? Number(family.expected_amount).toLocaleString() : 'N/A' %>
                      </td>
                      <td>
                          <%= family.last_payment_date ? new Date(family.last_payment_date).toLocaleDateString('en-GB') : 'Never' %>
                      </td>
                      <td>
                          <% if (family.package_status === 'pending') { %>
                              <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split"></i> Awaiting Approval</span>
                          <% } else if (family.package_status === 'expired') { %>
                              <span class="badge bg-danger">Expired</span>
                          <% } else { %>
                              <span class="badge bg-secondary">No Payment</span>
                          <% } %>
                      </td>
                      <td>
                        <div class="btn-group">
                          <button class="btn btn-sm btn-outline-warning" 
                                  title="Send SMS Reminder"
                                  onclick="sendReminder('<%= family.phone %>', '<%= family.family_name %>')">
                              <i class="bi bi-chat-dots"></i>
                          </button>
                          <a href="/family-details/<%= family.family_id %>" class="btn btn-sm btn-outline-primary">
                              <i class="bi bi-eye"></i>
                          </a>
                        </div>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="8" class="text-center py-5 text-success">
                      <i class="bi bi-check-circle-fill fs-2 d-block mb-2"></i>
                      Safari njema! Kila familia imelipia kifurushi chake.
                    </td>
                  </tr>
                <% } %>
              </tbody>
          </table>
            </div>
        </div>
        </div>

    </div>
