<main id="main" class="main">
  <div class="pagetitle">
    <h1>Registered Family</h1>
  </div>
  <div class="container-fluid">
    <div class="card shadow-sm">
      <div class="card-body">
        <div class="table-responsive">
          <table id="familiesTable" class="table table-striped table-hover nowrap">
            <thead class="table-light">
              <tr>
                <th>#</th>
                <th>Family Name</th>
                <th>Admin Name</th>
                <th>Phone</th>
                <th>Region</th>
                <th class="text-center">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% families.forEach((fam, index) => { %>
              <tr>
                <td><%= index + 1 %></td>
                <td><strong><%= fam.family_name %></strong></td>
                <td><%= fam.first_name %> <%= fam.last_name %></td>
                <td><%= fam.phone %></td>
                <td><%= fam.region %></td>
                <td class="text-center">
                  <button class="btn btn-sm btn-outline-primary me-1" 
                    onclick="viewFamily('<%= JSON.stringify(fam) %>')" title="View">
                    <i class="bi bi-eye"></i>
                  </button>

                  <button class="btn btn-sm btn-outline-warning me-1" 
                    onclick="editFamily('<%= JSON.stringify(fam) %>')" title="Edit">
                    <i class="bi bi-pencil-square"></i>
                  </button>

                  <button class="btn btn-sm btn-outline-danger" 
                    onclick="confirmDelete('<%= fam.family_id %>', '<%= fam.family_name %>')" title="Delete">
                    <i class="bi bi-trash"></i>
                  </button>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</main>

