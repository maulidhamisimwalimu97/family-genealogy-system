<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">

  <title>Dashboard - Member</title>
  <meta content="Family Admin Panel for managing family genealogy records" name="description">
  <meta content="family, genealogy, admin, lineage" name="keywords">

  <!-- Favicons -->


  <!-- Google Fonts -->
  <link href="https://fonts.gstatic.com" rel="preconnect">
  <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,300i,400,400i,600,600i,700,700i|Nunito:300,300i,400,400i,600,600i,700,700i|Poppins:300,300i,400,400i,500,500i,600,600i,700,700i" rel="stylesheet">

  <!-- Vendor CSS Files -->
  <link href="/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
  <link href="/assets/vendor/boxicons/css/boxicons.min.css" rel="stylesheet">
  <link href="/assets/vendor/quill/quill.snow.css" rel="stylesheet">
  <link href="/assets/vendor/quill/quill.bubble.css" rel="stylesheet">
  <link href="/assets/vendor/remixicon/remixicon.css" rel="stylesheet">
  <link href="/assets/vendor/simple-datatables/style.css" rel="stylesheet">

  <!-- Main CSS File -->
  <link href="assets/css/style.css" rel="stylesheet">
  <link href="/assets/css/dark.css" rel="stylesheet">
</head>

<body>

  <!-- ======= Header ======= -->
  <%- include('partials/title') %>
  <%- include('partials/header') %>

<main id="main" class="main">

  <!-- Page Title -->
  <div class="pagetitle d-flex justify-content-between align-items-center">
    <div>
      <h1>Member Dashboard</h1>
      <nav>
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/member_dashboard">Home</a></li>
          <li class="breadcrumb-item active">Dashboard</li>
        </ol>
      </nav>
    </div>
  </div>

  <section class="section dashboard">
    <div class="row">

      <!-- LEFT SIDE -->
      <div class="col-lg-8">
        <div class="row">

          <!-- 👨‍👩‍👧‍👦 Total Members -->
          <div class="col-xxl-4 col-md-6">
            <a href="/family_lists" class="text-decoration-none">
              <div class="card info-card shadow-sm">

                <div class="card-body">
                  <h5 class="card-title">Family Members</h5>

                  <div class="d-flex align-items-center">
                    <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                      <i class="bi bi-people"></i>
                    </div>

                    <div class="ps-3">
                      <h6><%= totalMembers %></h6>
                      <span class="text-muted small">Registered</span>
                    </div>
                  </div>
                </div>

              </div>
            </a>
          </div>

          <!-- 📅 Meetings -->
          <div class="col-xxl-4 col-md-6">
            <a href="/meeting_list" class="text-decoration-none">
              <div class="card info-card shadow-sm">

                <div class="card-body">
                  <h5 class="card-title">Upcoming Meetings</h5>

                  <div class="d-flex align-items-center">
                    <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                      <i class="bi bi-calendar-event"></i>
                    </div>

                    <div class="ps-3">
                      <h6><%= totalMeetings %></h6>
                      <span class="text-info small">Scheduled</span>
                    </div>
                  </div>
                </div>

              </div>
            </a>
          </div>

          <!-- 📊 Attendance (STATIC FOR NOW) -->
          <div class="col-xxl-4 col-md-6">
            <div class="card info-card shadow-sm">

              <div class="card-body">
                <h5 class="card-title">My Attendance</h5>

                <div class="d-flex align-items-center">
                  <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                    <i class="bi bi-check2-square"></i>
                  </div>

                  <div class="ps-3">
                    <h6>80%</h6>
                    <span class="text-success small">Participation</span>
                  </div>
                </div>
              </div>

            </div>
          </div>

          <!-- 🌳 Family Tree -->
          <div class="col-12">
            <a href="/family_tree" class="text-decoration-none">
              <div class="card shadow-sm">
                <div class="card-body">
                  <h5 class="card-title">Family Tree</h5>
                  <p class="small text-muted">
                    View your family lineage and understand your position.
                  </p>
                </div>
              </div>
            </a>
          </div>

          <!-- 📋 Recent Meetings -->
          <div class="col-12">
            <div class="card recent-sales overflow-auto shadow-sm">

              <div class="card-body">
                <h5 class="card-title">Recent Meetings</h5>

                <table class="table table-borderless datatable">
                  <thead>
                    <tr>
                      <th>#</th>
                      <th>Meeting</th>
                      <th>Date</th>
                      <th>Status</th>
                    </tr>
                  </thead>

                  <tbody>
                    <% if (recentMeetings.length === 0) { %>
                      <tr>
                        <td colspan="4" class="text-center text-muted">
                          No meetings available
                        </td>
                      </tr>
                    <% } else { %>

                      <% recentMeetings.forEach((m, i) => { %>
                        <tr>
                          <th><%= i + 1 %></th>
                          <td><%= m.title %></td>
                          <td><%= new Date(m.meeting_date).toDateString() %></td>
                          <td>
                            <span class="badge bg-info">Scheduled</span>
                          </td>
                        </tr>
                      <% }) %>

                    <% } %>
                  </tbody>
                </table>

              </div>
            </div>
          </div>

        </div>
      </div>

      <!-- RIGHT SIDE -->
      <div class="col-lg-4">

        <!-- 🔔 Activities -->
        <div class="card shadow-sm">
          <div class="card-body">
            <h5 class="card-title">Family Updates</h5>

            <div class="activity">

              <% if (activities.length === 0) { %>
                <div class="text-muted small">No updates available</div>
              <% } else { %>

                <% activities.forEach(act => { %>
                  <div class="activity-item d-flex">

                    <div class="activite-label">
                      <%= new Date(act.created_at).toLocaleDateString() %>
                    </div>

                    <i class="bi bi-circle-fill activity-badge text-primary align-self-start"></i>

                    <div class="activity-content">
                      New member <strong><%= act.name %></strong> joined
                    </div>

                  </div>
                <% }) %>

              <% } %>

            </div>

          </div>
        </div>

        <!-- 🔐 Access -->
        <div class="card shadow-sm">
          <div class="card-body">
            <h5 class="card-title">Your Access</h5>

            <ul class="small">
              <li>View family members</li>
              <li>Family tree</li>
              <li>Meetings & attendance</li>
              <li>Chats & communication</li>
              <li>Events participation</li>
            </ul>

            <p class="small text-muted mt-2">
              For administrative actions, contact your Family Admin.
            </p>
          </div>
        </div>

      </div>

    </div>
  </section>

</main>

<!-- ======= Footer ======= -->
    <footer id="footer" class="footer">
    <div class="copyright">
        &copy; Copyright <strong><span>Family Genealogy System</span></strong>. All Rights Reserved
    </div>
    <div class="credits">
        Developed by <strong>Maulid Mwalimu</strong>
    </div>
    </footer>
    <!-- End Footer -->

  <a href="#" class="back-to-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>

  <!-- Vendor JS Files -->
  <script src="/assets/vendor/apexcharts/apexcharts.min.js"></script>
  <script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script src="/assets/vendor/chart.js/chart.umd.js"></script>
  <script src="/assets/vendor/echarts/echarts.min.js"></script>
  <script src="/assets/vendor/quill/quill.js"></script>
  <script src="/assets/vendor/simple-datatables/simple-datatables.js"></script>
  <script src="/assets/vendor/tinymce/tinymce.min.js"></script>
  <script src="/assets/vendor/php-email-form/validate.js"></script>

  <!-- Main JS File -->
  <script src="/assets/js/main.js"></script>

</body>

</html>