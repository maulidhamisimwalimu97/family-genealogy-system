<!-- ======= Main Content (Family Member Dashboard) ======= -->
<main id="main" class="main">

  <div class="pagetitle">
    <h1>Member Dashboard</h1>
    <nav>
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/member_dashboard">Home</a></li>
        <li class="breadcrumb-item active">Dashboard</li>
      </ol>
    </nav>
  </div>

  <section class="section dashboard">
    <div class="row">

      <!-- Left Side -->
      <div class="col-lg-8">
        <div class="row">

          <!-- Total Family Members -->
          <div class="col-xxl-4 col-md-6">
            <a href="/family_lists" class="text-decoration-none">
              <div class="card info-card">
                <div class="card-body">
                  <h5 class="card-title">Family Members</h5>
                  <div class="d-flex align-items-center">
                    <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                      <i class="bi bi-people"></i>
                    </div>
                    <div class="ps-3">
                      <h6>25</h6>
                      <span class="text-muted small">Registered Members</span>
                    </div>
                  </div>
                </div>
              </div>
            </a>
          </div>

          <!-- My Upcoming Meetings -->
          <div class="col-xxl-4 col-md-6">
            <a href="/meeting_list" class="text-decoration-none">
              <div class="card info-card">
                <div class="card-body">
                  <h5 class="card-title">My Upcoming Meetings</h5>
                  <div class="d-flex align-items-center">
                    <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                      <i class="bi bi-calendar-event"></i>
                    </div>
                    <div class="ps-3">
                      <h6>2</h6>
                      <span class="text-info small">Scheduled</span>
                    </div>
                  </div>
                </div>
              </div>
            </a>
          </div>

          <!-- My Attendance -->
          <div class="col-xxl-4 col-md-6">
            <div class="card info-card">
              <div class="card-body">
                <h5 class="card-title">My Attendance</h5>
                <div class="d-flex align-items-center">
                  <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                    <i class="bi bi-check2-square"></i>
                  </div>
                  <div class="ps-3">
                    <h6>80%</h6>
                    <span class="text-success small">Participation Rate</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Family Tree -->
          <div class="col-12">
            <a href="/family_tree" class="text-decoration-none">
              <div class="card">
                <div class="card-body">
                  <h5 class="card-title">Family Tree</h5>
                  <p class="small">
                    View your family lineage and understand your position in the family structure.
                  </p>
                </div>
              </div>
            </a>
          </div>

          <!-- Recent Meetings -->
          <div class="col-12">
            <div class="card recent-sales overflow-auto">
              <div class="card-body">
                <h5 class="card-title">Recent Meetings</h5>

                <table class="table table-borderless">
                  <thead>
                    <tr>
                      <th>#</th>
                      <th>Meeting Title</th>
                      <th>Date</th>
                      <th>Status</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
                      <th>1</th>
                      <td>Monthly Family Gathering</td>
                      <td>12 Feb 2026</td>
                      <td><span class="badge bg-success">Attended</span></td>
                    </tr>
                    <tr>
                      <th>2</th>
                      <td>Budget Discussion</td>
                      <td>05 Jan 2026</td>
                      <td><span class="badge bg-danger">Missed</span></td>
                    </tr>
                  </tbody>
                </table>

              </div>
            </div>
          </div>

        </div>
      </div>

      <!-- Right Side -->
      <div class="col-lg-4">

        <!-- Recent Family Activities -->
        <div class="card">
          <div class="card-body">
            <h5 class="card-title">Family Updates</h5>

            <div class="activity">

              <div class="activity-item d-flex">
                <div class="activite-label">2h ago</div>
                <i class="bi bi-circle-fill activity-badge text-primary"></i>
                <div class="activity-content">
                  New member <strong>Omary Ambari</strong> joined the family
                </div>
              </div>

              <div class="activity-item d-flex">
                <div class="activite-label">Tomorrow</div>
                <i class="bi bi-circle-fill activity-badge text-warning"></i>
                <div class="activity-content">
                  Reminder: Family meeting at 8:00 PM
                </div>
              </div>

            </div>

          </div>
        </div>

        <!-- Member Info -->
        <div class="card">
          <div class="card-body">
            <h5 class="card-title">Your Access</h5>
            <ul class="small">
              <li>View family members</li>
              <li>View family tree</li>
              <li>See meeting schedules</li>
              <li>Attend meetings</li>
            </ul>
            <p class="mt-2 small text-muted">
              For administrative changes, contact the Family Admin.
            </p>
          </div>
        </div>

      </div>

    </div>
  </section>

