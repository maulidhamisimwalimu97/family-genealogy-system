<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Forgot Password</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
body{
    background:#f5f7fb;
    height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
}

.card{
    width:100%;
    max-width:420px;
    padding:20px;
    border-radius:12px;
}

.step{ display:none; }
.step.active{ display:block; }

.title{ text-align:center; color:#0d6efd; }
</style>
</head>

<body>

<div class="card">

<h4 class="title">Forgot Password</h4>

<div id="msg"></div>

<!-- STEP 1 -->
<div class="step active" id="step1">
<input id="phone" class="form-control mb-2" placeholder="Phone">
<button class="btn btn-primary w-100" onclick="sendOTP()">Send OTP</button>
</div>

<!-- STEP 2 -->
<div class="step" id="step2">
<input id="otp" class="form-control mb-2" placeholder="OTP">
<button class="btn btn-success w-100" onclick="verifyOTP()">Verify OTP</button>
</div>

<!-- STEP 3 -->
<div class="step" id="step3">
<input id="password" type="password" class="form-control mb-2" placeholder="New Password">
<button class="btn btn-warning w-100" onclick="resetPassword()">Reset</button>
</div>

</div>

<script>

let phoneGlobal = "";

function show(msg, type="danger"){
  document.getElementById("msg").innerHTML =
  `<div class="alert alert-${type}">${msg}</div>`;
}

function step(id){
  document.querySelectorAll(".step").forEach(s=>s.classList.remove("active"));
  document.getElementById(id).classList.add("active");
}

// SEND OTP
function sendOTP(){
  phoneGlobal = document.getElementById("phone").value;

  fetch("/send_otp", {
    method:"POST",
    headers:{ "Content-Type":"application/json" },
    body: JSON.stringify({ phone: phoneGlobal })
  })
  .then(r=>r.json())
  .then(data=>{
    if(data.success){
      show("OTP sent ✔","success");
      step("step2");
    }else{
      show(data.message);
    }
  });
}

// VERIFY OTP
function verifyOTP(){
  const otp = document.getElementById("otp").value;

  fetch("/verify_otp", {
    method:"POST",
    headers:{ "Content-Type":"application/json" },
    body: JSON.stringify({ phone: phoneGlobal, otp })
  })
  .then(r=>r.json())
  .then(data=>{
    if(data.success){
      show("OTP correct ✔","success");
      step("step3");
    }else{
      show(data.message);
    }
  });
}

// RESET PASSWORD
function resetPassword(){
  const password = document.getElementById("password").value;

  fetch("/reset_password", {
    method:"POST",
    headers:{ "Content-Type":"application/json" },
    body: JSON.stringify({ password })
  })
  .then(r=>r.json())
  .then(data=>{
    if(data.success){
      show("Password updated ✔","success");
      setTimeout(()=>location.href="/index",2000);
    }else{
      show(data.message);
    }
  });
}

</script>

</body>
</html>