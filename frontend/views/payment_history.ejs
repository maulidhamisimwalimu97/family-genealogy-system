<body>

  <!-- ======= Header ======= -->

<%- include('partials/title') %>

<%- include('partials/header') %>

<main id="main" class="main">
  <div class="pagetitle">
    <h1>Payment History</h1>
    <nav>
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/dashboard">Home</a></li>
        <li class="breadcrumb-item"><a href="/package">Subscription</a></li>
        <li class="breadcrumb-item active">History</li>
      </ol>
    </nav>
  </div>

  <section class="section">
    <div class="row">
      <div class="col-12">

        <div class="card recent-sales overflow-auto border-0 shadow-sm">
          <div class="card-body">
            <h5 class="card-title">My Subscription Payments <span>| All Time</span></h5>

            <table id="paymentHistoryTable" class="table table-hover datatable">
              <thead>
                <tr>
                  <th>#</th>
                  <th>Member</th>
                  <th>Package Name</th>
                  <th>Amount (TZS)</th>
                  <th>Ref Number</th>
                  <th>Date Paid</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% if (history && history.length > 0) { %>
                  <% history.forEach((pay, index) => { %>
                    <tr>
                      <td><%= index + 1 %></td>
                      <td><%= pay.first_name %> <%= pay.last_name %></td>
                      <td><span class="fw-bold text-primary"><%= pay.package_name || 'N/A' %></span></td>
                      <td><%= (pay.amount).toLocaleString() %></td>
                      <td><code><%= pay.reference_number %></code></td>
                      <td><%= new Date(pay.payment_date).toLocaleDateString('en-GB') %></td>
                      <td>
                        <% if (pay.status === 'paid' || pay.status === 'active') { %>
                          <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Verified</span>
                        <% } else if (pay.status === 'pending') { %>
                          <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i> Pending</span>
                        <% } else { %>
                          <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i> Rejected</span>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="7" class="text-center py-4 text-muted">Bado haujafanya malipo yoyote ya kifurushi.</td>
                  </tr>
                <% } %>
              </tbody>
            </table>

          </div>
        </div>

      </div>
    </div>
  </section>
</main>

<!-- Google Translate Element -->
<div id="google_translate_element" style="visibility: hidden; position: absolute; z-index: -1;"></div>

<script>
function googleTranslateElementInit() {
  new google.translate.TranslateElement({
    pageLanguage: 'en',
    includedLanguages: 'en,sw',
    autoDisplay: false
  }, 'google_translate_element');

  var savedLang = localStorage.getItem("selectedLanguage");
  if (savedLang) {
    setTimeout(function () {
      setLanguage(savedLang);
    }, 800);
  }
}

function changeLanguage(lang) {
  localStorage.setItem("selectedLanguage", lang);
  setLanguage(lang);
}

function setLanguage(lang) {
  var select = document.querySelector(".goog-te-combo");
  if (select) {
    select.value = lang;
    select.dispatchEvent(new Event("change"));
  } else {
    setTimeout(function () {
      setLanguage(lang);
    }, 300);
  }
}
</script>

